 install(DIRECTORY ${CMAKE_SOURCE_DIR}/mia/Database DESTINATION system/ares)
 
+# license texts must travel with binaries (several BSD licenses require it)
+install(FILES ${CMAKE_SOURCE_DIR}/LICENSE DESTINATION licenses/ares_libretro RENAME LICENSE-ares.txt)
+install(FILES LICENSE DESTINATION licenses/ares_libretro RENAME LICENSE-libretro-core.txt)
+install(FILES THIRD-PARTY-NOTICES.txt DESTINATION licenses/ares_libretro)
+
+# headless test frontend (libretro/tests/harness.cpp), used by CI
+option(ARES_LIBRETRO_TESTS "Build the headless libretro test harness" OFF)
+if(ARES_LIBRETRO_TESTS)
+  add_executable(ares_libretro_harness tests/harness.cpp)
+  target_compile_features(ares_libretro_harness PRIVATE cxx_std_17)
+  target_link_libraries(ares_libretro_harness PRIVATE ${CMAKE_DL_LIBS})
+  if(MINGW)
+    target_link_options(ares_libretro_harness PRIVATE -static)
+  endif()
+  add_dependencies(ares_libretro_harness ares_libretro)
+endif()
+
 target_enable_subproject(ares_libretro "ares libretro core")
