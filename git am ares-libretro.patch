diff --git a/libretro/tests/run.sh b/libretro/tests/run.sh
new file mode 100755
index 0000000..cd5b71e
--- /dev/null
+++ b/libretro/tests/run.sh
@@ -0,0 +1,53 @@
+#!/usr/bin/env bash
+# SPDX-License-Identifier: ISC
+# Smoke tests for an ares_libretro build, run by CI on every platform.
+#   tests/run.sh <path to ares_libretro.{so,dll,dylib}> <path to ares_libretro_harness>
+set -euo pipefail
+
+CORE="$1"
+HARNESS="$2"
+HERE="$(cd "$(dirname "$0")" && pwd)"
+SOURCE="$(cd "$HERE/../.." && pwd)"
+WORK="${RUNNER_TEMP:-${TMPDIR:-/tmp}}/ares-libretro-tests"
+# on Windows (Git Bash / MSYS2) use C:/style paths that both bash and native programs accept
+if command -v cygpath > /dev/null 2>&1; then WORK="$(cygpath -m "$WORK")"; fi
+# prefer "python": on Windows "python3" may be the Microsoft Store stub
+PYTHON="$(command -v python || command -v python3)"
+
+rm -rf "$WORK"
+mkdir -p "$WORK/roms" "$WORK/system/ares" "$WORK/saves"
+cp -r "$SOURCE/mia/Database" "$WORK/system/ares/"
+"$PYTHON" "$HERE/make_roms.py" "$WORK/roms"
+export SYSDIR="$WORK/system" SAVEDIR="$WORK/saves"
+
+failures=0
+check() {
+  local name="$1"; shift
+  if "$HARNESS" "$CORE" "$@" > "$WORK/log.txt" 2>&1; then
+    echo "PASS  $name"
+  else
+    echo "FAIL  $name"; cat "$WORK/log.txt"; failures=$((failures + 1))
+  fi
+}
+quiet="--opt ares_interframe_blending=disabled"
+R="$WORK/roms"
+
+# RetroPad A = id 8, RetroPad B = id 0
+check "NES boots, renders, states replay"   "$R/test.nes" 120 --state-test $quiet --expect-center 66afff
+check "NES input (A turns backdrop red)"    "$R/test.nes" 120 --press 8@60-200 $quiet --expect-center b23322
+check "SNES boots (red backdrop)"           "$R/test.sfc" 30 --state-test $quiet --expect-center ff0000
+check "Game Boy idle (black screen)"        "$R/test.gb" 700 $quiet --expect-center 1a452a
+check "Game Boy input (A turns white)"      "$R/test.gb" 700 --press 8@600-800 $quiet --expect-center aed927
+check "Mega Drive boots, states replay"      "$R/test.md" 120 --state-test $quiet
+check "Master System boots, states replay"   "$R/test.sms" 120 --state-test $quiet
+check "PC Engine boots, states replay"       "$R/test.pce" 120 --state-test $quiet
+check "WonderSwan boots, states replay"      "$R/test.ws" 120 --state-test $quiet
+check "Atari 2600 without VSYNC does not hang" "$R/test.a26" 120 --state-test $quiet
+check "zip content"                         "$R/test.zip" 30 $quiet --expect-center ff0000
+check "switch systems in one process"       "$R/test.nes" 30 $quiet --second "$R/test.gb"
+check "missing GBA BIOS fails cleanly"      "$R/test.gba" 5 --expect-fail
+check "battery RAM is written"              "$R/battery.gb" 300 $quiet
+if [ -f "$WORK/saves/ares/Game Boy/battery.ram" ]; then echo "PASS  battery save file exists"; else echo "FAIL  battery save file missing"; failures=$((failures + 1)); fi
+
+echo "$failures failure(s)"
+exit $failures
