diff --git a/libretro/CMakeLists.txt b/libretro/CMakeLists.txt
new file mode 100644
index 0000000..ff12434
--- /dev/null
+++ b/libretro/CMakeLists.txt
@@ -0,0 +1,60 @@
+#  ares libretro core
+#
+#  Configure from the ares source root with:
+#    cmake -S . -B build-libretro -G Ninja -DARES_BUILD_LIBRETRO=ON -DARES_BUILD_DESKTOP=OFF
+#    cmake --build build-libretro --target ares_libretro
+
+add_library(ares_libretro SHARED libretro.cpp)
+
+target_sources(
+  ares_libretro
+  PRIVATE
+    libretro.h
+    core.hpp
+    options.cpp
+    input.cpp
+    input-map.hpp
+    systems.cpp
+    link.T
+    ares_libretro.info
+    tools/gen-input-map.py
+)
+set_source_files_properties(options.cpp input.cpp systems.cpp PROPERTIES HEADER_FILE_ONLY TRUE)
+
+target_include_directories(ares_libretro PRIVATE ${CMAKE_SOURCE_DIR} ${CMAKE_CURRENT_SOURCE_DIR})
+target_compile_definitions(ares_libretro PRIVATE MIA_LIBRARY)
+target_link_libraries(ares_libretro PRIVATE ares::ares ares::mia ares::nall)
+
+set_target_properties(
+  ares_libretro
+  PROPERTIES
+    PREFIX ""
+    OUTPUT_NAME ares_libretro
+    CXX_VISIBILITY_PRESET hidden
+    VISIBILITY_INLINES_HIDDEN ON
+)
+
+if(OS_LINUX OR OS_FREEBSD OR OS_OPENBSD)
+  # catch missing symbols at link time rather than when RetroArch dlopen()s the core, and
+  # export only the libretro API so bundled libraries (libchdr, sljit, ...) can't clash
+  # with the same libraries inside other cores or the frontend
+  target_link_options(ares_libretro PRIVATE -Wl,--no-undefined -Wl,--version-script=${CMAKE_CURRENT_SOURCE_DIR}/link.T)
+  set_target_properties(ares_libretro PROPERTIES LINK_DEPENDS ${CMAKE_CURRENT_SOURCE_DIR}/link.T)
+endif()
+
+if(OS_MACOS)
+  target_link_options(ares_libretro PRIVATE "LINKER:-exported_symbol,_retro_*")
+endif()
+
+if(OS_WINDOWS)
+  # avoid a libstdc++/libgcc DLL dependency for MinGW builds
+  target_link_options(ares_libretro PRIVATE $<$<CXX_COMPILER_ID:GNU>:-static-libgcc -static-libstdc++>)
+endif()
+
+# install layout matches what RetroArch expects: the core goes in cores/, and ares'
+# database files go in <system>/ares/Database/
+install(TARGETS ares_libretro LIBRARY DESTINATION cores RUNTIME DESTINATION cores)
+install(FILES ares_libretro.info DESTINATION info)
+install(DIRECTORY ${CMAKE_SOURCE_DIR}/mia/Database DESTINATION system/ares)
+
+target_enable_subproject(ares_libretro "ares libretro core")
diff --git a/libretro/README.md b/libretro/README.md
new file mode 100644
index 0000000..909f562
--- /dev/null
+++ b/libretro/README.md
@@ -0,0 +1,172 @@
+# ares libretro core
+
+A libretro frontend for [ares](https://github.com/ares-emulator/ares). It plays the role
+`desktop-ui` plays in the standalone emulator: it uses the **mia** media library to load
+games and firmware, boots the ares system node tree, and implements `ares::Platform`
+(video, audio, input, and storage callbacks) on top of the libretro API. The emulation
+cores themselves are untouched upstream code.
+
+## Supported systems
+
+| System | Extensions | Firmware (in `system/ares/`) |
+|---|---|---|
+| Famicom / NES | nes fc unf unif | none |
+| Famicom Disk System | fds | `disksys.rom` **required** |
+| Super Famicom / SNES | sfc smc swc fig | none |
+| Game Boy / Game Boy Color | gb gbc | none (ares ships its own boot ROMs) |
+| Game Boy Advance | gba | `gba_bios.bin` **required** |
+| Nintendo 64 | n64 z64 v64 | none |
+| Master System | sms ms | `bios_U.sms` / `bios_J.sms` / `bios_E.sms` optional |
+| Game Gear | gg | `bios.gg` optional |
+| SG-1000 | sg sg1000 | none |
+| Mega Drive / Genesis | md gen smd bin | none |
+| Mega 32X | 32x | none |
+| Mega CD / Sega CD | cue chd | `bios_CD_U.bin` / `bios_CD_J.bin` / `bios_CD_E.bin` **required** |
+| PC Engine / TurboGrafx-16 | pce | none |
+| SuperGrafx | sgx | none |
+| PC Engine CD / TurboGrafx-CD | cue chd | `syscard3.pce` (JP), `syscard3u.pce` (US), `syscard1.pce`, `gexpress.pce` |
+| PlayStation | cue chd exe | `scph5501.bin` (US), `scph5500.bin` (JP), `scph5502.bin` (EU) **required** |
+| WonderSwan / Color | ws wsc | none |
+| Pocket Challenge V2 | pc2 pcv2 | none |
+| Neo Geo Pocket / Color | ngp ngc ngpc | `ngp_bios.bin` / `ngpc_bios.bin` **required** |
+| ColecoVision | col | `colecovision.rom` **required** |
+| Atari 2600 | a26 bin | none |
+| Atari 5200 | a52 car | `5200.rom` **required** |
+| MSX / MSX2 | msx rom mx1 / msx2 mx2 | `msx.rom`; `msx2.rom` + `msx2ext.rom` **required** |
+| MyVision | myv | none |
+
+`.zip` archives are supported for every system (mia reads them directly). Alternative
+firmware file names are accepted too (eg `scph1001.bin`, `us_scd1_9210.bin`); the full list
+is in `systems.cpp`. Firmware is looked up in `system/ares/` first, then `system/`.
+
+The system is chosen from the file extension, header bytes for ambiguous cases (`.gb` with
+the CGB flag runs as Game Boy Color; `.bin` is Mega Drive if it carries a `SEGA` header,
+otherwise Atari 2600), disc signatures for `.cue`/`.chd`, and mia's own probing for the
+rest. The **Force System** core option overrides detection.
+
+## Building
+
+The core builds from the ares source tree. The `ARES_BUILD_DESKTOP=OFF` switch skips the GUI
+(ruby/hiro/desktop-ui), so no GTK/OpenGL/SDL development packages are needed.
+
+```sh
+cmake -S . -B build-libretro -G Ninja \
+      -DCMAKE_BUILD_TYPE=Release \
+      -DARES_BUILD_LIBRETRO=ON -DARES_BUILD_DESKTOP=OFF
+cmake --build build-libretro --target ares_libretro
+# result: build-libretro/libretro/ares_libretro.so (.dll / .dylib)
+```
+
+To build only some systems, pass eg `-DARES_CORES="fc;sfc;gb;gba;md;ms"`.
+
+Building the libretro core turns on position-independent code for all of ares and defines
+`ARES_VIDEO_UNTHREADED` (see below), so use a separate build directory from the desktop app.
+
+## Installing
+
+1. Copy `ares_libretro.so` to RetroArch's `cores/` directory and `ares_libretro.info` to `info/`.
+2. Copy ares' `mia/Database` folder to `<RetroArch system dir>/ares/Database`. It holds the
+   game databases and board definitions mia needs (eg Super Famicom boards).
+3. Put any BIOS files in `<RetroArch system dir>/ares/`.
+
+`cmake --install build-libretro --prefix <dir>` lays out `cores/`, `info/` and
+`system/ares/Database/` for you.
+
+## Saves, states and disks
+
+* **Cartridge saves** (SRAM, EEPROM, flash, RTC), memory cards (PlayStation, N64
+  Controller Pak) and internal system memory are written by ares itself to
+  `<saves dir>/ares/<System>/<game>.<ext>` when content is closed or the console is reset.
+  RetroArch's `.srm` mechanism is not used.
+* **Save states, rewind, run-ahead and netplay** are supported. Ordinary states bring all of
+  ares' threads to a synchronization point first (as desktop ares does). When the frontend
+  reports a run-ahead/netplay context, the faster unsynchronized path is used.
+* With **Interframe Blending** on, the first frame after loading a state is blended with
+  the frame shown before the load (the blend history lives in the screen, not the emulated
+  state). Emulation itself is unaffected; turn the option off for bit-exact frame comparisons.
+* **Famicom Disk System** sides are exposed through the disk control interface
+  (Disc Control menu: eject, pick "Disk 1: Side B", insert).
+
+## Controls
+
+Controller layouts come from desktop ares itself: `tools/gen-input-map.py` reads every
+`device.digital(...)`/`device.analog(...)` line in `desktop-ui/emulator/*.cpp` and generates
+`input-map.hpp`. Desktop ares maps every console onto an abstract "virtual pad" that has the
+same layout as the RetroPad, so the result matches standard libretro conventions (SNES B/A/Y/X
+on RetroPad B/A/Y/X, Mega Drive A/B/C on Y/B/A, PlayStation Cross/Circle on B/A, N64 C-buttons
+on the right analog stick, and so on). One deliberate difference: NES/Famicom A and B are on
+RetroPad A and B, as in other libretro NES cores (desktop ares puts NES A on the bottom
+button). Re-run the script after updating ares.
+
+* Every peripheral ares supports on a port (Super Scope, Zapper, mice, paddles, Fighting
+  Pad, DualShock, Super Multitap, ...) shows up in RetroArch's per-port device list.
+  Mouse-style devices read the libretro mouse.
+* Numeric keypads (ColecoVision, Atari 5200, NTT Data Keypad) read the keyboard's
+  number row or numeric keypad (`*` = keypad multiply or `-`, `#` = keypad divide or `=`).
+* Rumble (N64 Rumble Pak, DualShock, Game Boy Player, rumble cartridges) uses the libretro
+  rumble interface.
+
+## Core options
+
+Force System, Preferred Region, Fast Boot, Dynamic Recompiler; Aspect Ratio, Overscan,
+Color Emulation, Interframe Blending, Color Bleed, Deinterlacing, Pixel Accuracy;
+Super Famicom Deep Black Boost, Mega Drive TMSS, GBA Game Boy Player, and N64 GPU
+acceleration, internal resolution, supersampling and Expansion Pak. Options marked
+"(restart)" apply the next time content is loaded; the video options apply immediately.
+
+## How it works
+
+| File | Purpose |
+|---|---|
+| `libretro.cpp` | libretro entry points; `ares::Platform` implementation; states; disk control |
+| `systems.cpp` | per-system loaders (port of `desktop-ui/emulator/*.cpp` without the GUI); system detection |
+| `input.cpp` | resolves each polled ares input node to RetroPad/analog/mouse/keyboard state; port device selection |
+| `options.cpp` | core options (v2 API, with a v0 fallback) |
+| `input-map.hpp` | generated controller tables |
+
+Small changes outside this directory:
+
+* `CMakeLists.txt`: `ARES_BUILD_DESKTOP` (default ON) and `ARES_BUILD_LIBRETRO`
+  (default OFF) options. With the defaults, the desktop build is unchanged.
+* `ares/ares/ares.hpp`, `ares/CMakeLists.txt`: `ARES_VIDEO_UNTHREADED`. ares normally
+  renders each frame on a worker thread, so `Platform::video()` would arrive after `run()`
+  returns. libretro needs the frame inside `retro_run()` (run-ahead and netplay depend on it),
+  so the libretro build renders synchronously.
+* `mia/mia.cpp`, `mia/mia.hpp`: `mia::setResourceLocation()`, a hook that lets the frontend
+  say where `Database/` lives (`mia::locate()` otherwise searches next to the executable,
+  which for a core would be RetroArch's directory).
+
+Every ares core returns from `System::run()` once per emulated frame (N64's CPU loop runs
+until the VI refreshes), so `retro_run()` calls it exactly once. Frames without new video
+(eg an Atari 2600 game that stops issuing VSYNC) repeat the previous frame. Audio streams
+are resampled by ares to 48 kHz and mixed exactly as desktop ares does. The reported frame
+rate starts at the system's nominal rate and is updated from ares' own refresh-rate hint
+via `SET_SYSTEM_AV_INFO`.
+
+## Not supported yet
+
+* Super Game Boy, BS-X Satellaview and Sufami Turbo (they need a second content image;
+  this could use libretro subsystems), Nintendo 64DD, N64 Transfer Pak.
+* Multi-disc swapping (`.m3u`) for CD systems. FDS side switching works.
+* MSX cassette images and keyboard input; ZX Spectrum; Neo Geo AES/MVS and arcade boards.
+* Cheats, RetroAchievements memory maps.
+* N64 GPU acceleration creates its own Vulkan device and reads frames back to the CPU;
+  it does not use RetroArch's Vulkan context (`SET_HW_RENDER`).
+
+## Testing done
+
+`tests/` contains the harness used during development: `harness.cpp` is a minimal headless
+libretro frontend and `make_roms.py` writes small homebrew test images
+(`g++ -std=c++17 -o harness tests/harness.cpp -ldl && python3 tests/make_roms.py /tmp`).
+
+Built on Linux x86-64 (GCC) against ares commit `0b92893`. A headless libretro harness
+(`dlopen` + the libretro API) ran small homebrew test images for NES, SNES, Game Boy, Mega
+Drive, Master System, PC Engine, WonderSwan and Atari 2600. It checked that video frames
+arrive every `retro_run`, audio matches the reported frame rate, input reaches the game
+(NES and Game Boy test programs react to button presses), save-state round-trips replay
+bit-identically, cartridge battery RAM is saved and reloaded, `.zip` loading works, and
+loading a second game of a different system in the same process works. CD system
+detection and missing-firmware errors were checked with synthetic disc images. N64, GBA,
+PlayStation and the CD systems were not run with real software (no commercial images or
+BIOS files were available), and the core has not yet been loaded inside RetroArch itself
+or built on Windows/macOS.
