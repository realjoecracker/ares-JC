+#ifdef CORE_N64
+auto loadNintendo64(Session& s) -> bool {
+  if(!loadGame(s, "Nintendo 64")) return false;
+  if(!loadSystem(s, "Nintendo 64")) return false;
+  ares::Nintendo64::option("Enable GPU acceleration", option::enabled("ares_n64_gpu", true));
+  ares::Nintendo64::option("Quality", option::get("ares_n64_quality", "SD"));
+  ares::Nintendo64::option("Supersampling", option::enabled("ares_n64_supersampling"));
+  ares::Nintendo64::option("Recompiler", recompiler());
+  ares::Nintendo64::option("Expansion Pak", option::enabled("ares_n64_expansion_pak", true));
+  ares::Nintendo64::option("Controller Pak Banks", "32KiB (Default)");
+  ares::Nintendo64::option("Homebrew Mode", false);
+  s.bind("Nintendo 64", s.system);
+  s.bind("Nintendo 64 Cartridge", s.game);
+  if(!boot(s, ares::Nintendo64::load, "[Nintendo] Nintendo 64")) return false;
+  connect(s, "Cartridge Slot");
+
+  //Jeopardy! does not accept any input if more than 3 controllers are plugged in at boot
+  u32 count = s.game->pak->attribute("id") == "NJOE" ? 3 : 4;
+  controllers(s, count, "Gamepad");
+
+  //accessory in each controller's pak slot, as declared by the game database
+  std::shared_ptr<mia::Pak> controllerPak;
+  for(u32 id = 0; id < s.controllerPorts.size(); id++) {
+    auto port = s.root->find<ares::Node::Port>(s.controllerPorts[id]);
+    if(!port || !port->connected()) continue;
+    auto slot = port->connected()->find<ares::Node::Port>("Pak");
+    if(!slot) continue;
+    if(s.game->pak->attribute({"port", id + 1, "/cpak"}).boolean() && !controllerPak) {
+      //ares maps every Controller Pak to the single "Gamepad" pak, as desktop-ui does
+      controllerPak = mia::Pak::create("Nintendo 64");
+      controllerPak->pak->append("save.pak", 1984_KiB);
+      controllerPak->load("save.pak", ".pak", s.game->location);
+      s.bind("Gamepad", controllerPak);
+      slot->allocate("Controller Pak");
+      slot->connect();
+    } else if(s.game->pak->attribute({"port", id + 1, "/rpak"}).boolean()) {
+      slot->allocate("Rumble Pak");
+      slot->connect();
+    }
+  }
+
+  s.savers.push_back([&s, controllerPak] {
+    s.system->save(s.system->location);
+    s.game->save(s.game->location);
+    if(controllerPak) controllerPak->save("save.pak", ".pak", s.game->location);
+  });
+  return true;
+}
+#endif
