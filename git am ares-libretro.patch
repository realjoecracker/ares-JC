diff --git a/libretro/core.hpp b/libretro/core.hpp
new file mode 100644
index 0000000..e9f1b3e
--- /dev/null
+++ b/libretro/core.hpp
@@ -0,0 +1,141 @@
+#pragma once
+
+//ares libretro core
+//
+//this is a frontend for the ares emulator, playing the same role as desktop-ui:
+//it builds the emulated system's node tree via the mia media library, implements
+//ares::Platform (video/audio/input/pak callbacks), and drives emulation from retro_run().
+
+#include <mia/mia.hpp>
+#include "libretro.h"
+
+#include <atomic>
+#include <deque>
+#include <unordered_map>
+
+namespace ares_libretro {
+
+//------------------------------------------------------------------------------
+//libretro callbacks
+
+inline retro_environment_t       environ_cb;
+inline retro_video_refresh_t     video_cb;
+inline retro_audio_sample_t      audio_cb;
+inline retro_audio_sample_batch_t audio_batch_cb;
+inline retro_input_poll_t        input_poll_cb;
+inline retro_input_state_t       input_state_cb;
+inline retro_log_printf_t        log_cb;
+inline retro_set_rumble_state_t  rumble_cb;
+
+inline auto log(retro_log_level level, const string& text) -> void {
+  if(log_cb) log_cb(level, "[ares] %s\n", (const char*)text);
+  else fprintf(stderr, "[ares] %s\n", (const char*)text);
+}
+
+//on-screen notification (also logged)
+inline auto notify(const string& text, u32 frames = 240, retro_log_level level = RETRO_LOG_INFO) -> void {
+  log(level, text);
+  if(!environ_cb) return;
+  retro_message_ext ext{};
+  ext.msg = text;
+  ext.duration = frames * 1000 / 60;
+  ext.priority = 1;
+  ext.level = level;
+  ext.target = RETRO_MESSAGE_TARGET_ALL;
+  ext.type = RETRO_MESSAGE_TYPE_NOTIFICATION;
+  ext.progress = -1;
+  if(environ_cb(RETRO_ENVIRONMENT_SET_MESSAGE_EXT, &ext)) return;
+  retro_message msg{text, frames};
+  environ_cb(RETRO_ENVIRONMENT_SET_MESSAGE, &msg);
+}
+
+//------------------------------------------------------------------------------
+//directories
+
+struct Paths {
+  string system;    //<frontend system dir>/ares/  (firmware, Database/)
+  string systemBase;//<frontend system dir>/       (firmware fallback location)
+  string saves;     //<frontend save dir>/ares/    (cartridge saves, memory cards)
+};
+inline Paths paths;
+
+//------------------------------------------------------------------------------
+//a loaded game session: everything desktop-ui keeps in its Emulator object
+
+struct SystemDesc;
+
+struct Session {
+  const SystemDesc* desc = nullptr;
+  string location;                     //path of the content file
+  string region;                       //resolved region ("NTSC-U", "NTSC-J", "PAL", ...)
+  ares::Node::System root;
+
+  std::shared_ptr<mia::Pak> game;
+  std::shared_ptr<mia::Pak> system;
+  std::vector<std::pair<string, std::shared_ptr<mia::Pak>>> paks;  //node name -> pak
+  std::vector<std::function<void ()>> savers;                     //run on save()
+
+  //ares ports that represent the libretro controller ports, in player order
+  std::vector<string> controllerPorts;
+  //per-port default peripheral chosen by the system loader
+  std::vector<string> defaultDevices;
+
+  auto bind(const string& nodeName, std::shared_ptr<mia::Pak> pak) -> void {
+    if(pak) paks.push_back({nodeName, pak});
+  }
+
+  auto pak(ares::Node::Object node) -> std::shared_ptr<vfs::directory> {
+    for(auto& [name, pak] : paks) {
+      if(node->name() == name && pak) return pak->pak;
+    }
+    return {};
+  }
+
+  auto save() -> void {
+    if(!root) return;
+    root->save();
+    for(auto& saver : savers) saver();
+  }
+};
+
+inline Session session;
+
+//------------------------------------------------------------------------------
+//per-system description (systems.cpp)
+
+struct SystemDesc {
+  const char* name;       //ares/mia system name, eg "Super Famicom"
+  const char* inputName;  //name of this system's controller table in input-map.hpp
+  const char* core;       //short id used in core options
+  std::vector<string> extensions;
+  f64 defaultFps;         //used until the core reports its precise refresh rate
+  auto (*load)(Session&) -> bool;
+};
+
+auto systems() -> const std::vector<SystemDesc>&;
+auto findSystem(const string& name) -> const SystemDesc*;
+auto detectSystem(const string& location) -> const SystemDesc*;
+
+//------------------------------------------------------------------------------
+//core options (options.cpp)
+
+namespace option {
+  auto install() -> void;
+  auto get(const char* key, const char* fallback = "") -> string;
+  auto enabled(const char* key, bool fallback = false) -> bool;
+  auto updated() -> bool;
+}
+
+//------------------------------------------------------------------------------
+//input (input.cpp)
+
+namespace input {
+  auto reset() -> void;
+  auto frame() -> void;
+  auto poll(ares::Node::Input::Input node) -> void;
+  auto setControllerInfo() -> void;
+  auto setPortDevice(u32 port, u32 device) -> void;
+  auto setDescriptors() -> void;
+}
+
+}
