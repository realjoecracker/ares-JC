diff --git a/libretro/input.cpp b/libretro/input.cpp
new file mode 100644
index 0000000..d9a39b6
--- /dev/null
+++ b/libretro/input.cpp
@@ -0,0 +1,407 @@
+//input: translate ares input polls into libretro input state.
+//
+//ares polls individual input nodes (buttons, axes, triggers, rumble motors) lazily while
+//emulating. Each node lives under a device node (eg "Gamepad") which lives under a port node
+//(eg "Controller Port 1"). We resolve (device, input name) through the table generated from
+//desktop-ui, which describes every input in terms of an abstract "virtual pad" that maps
+//1:1 onto the RetroPad.
+
+namespace ares_libretro::input {
+
+using namespace map;
+
+namespace {
+
+struct Binding {
+  const Input* input = nullptr;
+  u32 player = 0;
+  u64 lastRelativeFrame = ~0ull;
+};
+
+std::unordered_map<const void*, Binding> cache;
+u64 frameCounter = 0;
+bool useBitmasks = false;
+
+//per-frame joypad state cache
+struct PadCache { u64 frame = ~0ull; int16_t mask = 0; };
+PadCache pads[8];
+
+//per-port device selection
+struct PortDevice { u32 id; string name; };
+std::vector<std::vector<PortDevice>> portDevices;
+std::vector<u32> requestedDevices;   //set before a game was loaded
+std::deque<string> descriptorNames;  //deque: element addresses stay valid on push_back
+std::vector<retro_input_descriptor> descriptors;
+std::vector<retro_controller_description> controllerDescriptions;
+std::vector<retro_controller_info> controllerInfo;
+
+auto systemTable() -> const System* {
+  if(!session.desc) return nullptr;
+  for(auto& s : systemTables) {
+    if(string{s.name} == session.desc->inputName) return &s;
+  }
+  return nullptr;
+}
+
+auto findDevice(const string& name) -> const Device* {
+  if(auto table = systemTable()) {
+    for(u32 i = 0; i < table->count; i++) {
+      if(name == table->devices[i].name) return &table->devices[i];
+    }
+  }
+  //peripherals shared between systems (eg Mega Drive pads on Master System)
+  for(auto& s : systemTables) {
+    for(u32 i = 0; i < s.count; i++) {
+      if(name == s.devices[i].name) return &s.devices[i];
+    }
+  }
+  return nullptr;
+}
+
+auto findInput(const Device* device, const string& name) -> const Input* {
+  if(!device) return nullptr;
+  for(u32 i = 0; i < device->count; i++) {
+    if(name == device->inputs[i].name) return &device->inputs[i];
+  }
+  return nullptr;
+}
+
+auto playerForPort(const string& portName) -> u32 {
+  for(u32 i = 0; i < session.controllerPorts.size(); i++) {
+    if(session.controllerPorts[i] == portName) return i;
+  }
+  //Super Famicom Super Multitap: ports 1-4 become players 2-5
+  if(portName.beginsWith("Multitap Port ")) {
+    auto n = string{portName}.trimLeft("Multitap Port ", 1L).natural();
+    if(n >= 1 && n <= 4) return n;
+  }
+  return 0;
+}
+
+auto joypadMask(u32 player) -> int16_t {
+  auto& pad = pads[player & 7];
+  if(pad.frame == frameCounter) return pad.mask;
+  pad.frame = frameCounter;
+  if(useBitmasks) {
+    pad.mask = input_state_cb(player, RETRO_DEVICE_JOYPAD, 0, RETRO_DEVICE_ID_JOYPAD_MASK);
+  } else {
+    pad.mask = 0;
+    for(u32 id = 0; id <= RETRO_DEVICE_ID_JOYPAD_R3; id++) {
+      if(input_state_cb(player, RETRO_DEVICE_JOYPAD, 0, id)) pad.mask |= 1 << id;
+    }
+  }
+  return pad.mask;
+}
+
+auto button(u32 player, u32 id) -> s32 { return joypadMask(player) & (1 << id) ? 32767 : 0; }
+
+auto stick(u32 player, u32 index, u32 axis, s32 sign) -> s32 {
+  s32 value = input_state_cb(player, RETRO_DEVICE_ANALOG, index, axis);
+  value *= sign;
+  return value > 0 ? min(value, 32767) : 0;
+}
+
+auto analogButton(u32 player, u32 id) -> s32 {
+  s32 value = input_state_cb(player, RETRO_DEVICE_ANALOG, RETRO_DEVICE_INDEX_ANALOG_BUTTON, id);
+  if(value > 0) return min(value, 32767);
+  return button(player, id);
+}
+
+auto key(u32 a, u32 b = RETROK_UNKNOWN) -> s32 {
+  if(input_state_cb(0, RETRO_DEVICE_KEYBOARD, 0, a)) return 32767;
+  if(b != RETROK_UNKNOWN && input_state_cb(0, RETRO_DEVICE_KEYBOARD, 0, b)) return 32767;
+  return 0;
+}
+
+auto mouse(u32 player, u32 id) -> s32 {
+  return input_state_cb(player, RETRO_DEVICE_MOUSE, 0, id) ? 32767 : 0;
+}
+
+//returns 0..32767 for buttons and single-direction analog fields
+auto magnitude(u32 p, Field field) -> s32 {
+  switch(field) {
+  case Field::Pad_up:           return button(p, RETRO_DEVICE_ID_JOYPAD_UP);
+  case Field::Pad_down:         return button(p, RETRO_DEVICE_ID_JOYPAD_DOWN);
+  case Field::Pad_left:         return button(p, RETRO_DEVICE_ID_JOYPAD_LEFT);
+  case Field::Pad_right:        return button(p, RETRO_DEVICE_ID_JOYPAD_RIGHT);
+  case Field::Pad_select:       return button(p, RETRO_DEVICE_ID_JOYPAD_SELECT);
+  case Field::Pad_start:        return button(p, RETRO_DEVICE_ID_JOYPAD_START);
+  case Field::Pad_south:        return button(p, RETRO_DEVICE_ID_JOYPAD_B);
+  case Field::Pad_east:         return button(p, RETRO_DEVICE_ID_JOYPAD_A);
+  case Field::Pad_west:         return button(p, RETRO_DEVICE_ID_JOYPAD_Y);
+  case Field::Pad_north:        return button(p, RETRO_DEVICE_ID_JOYPAD_X);
+  case Field::Pad_l_bumper:     return button(p, RETRO_DEVICE_ID_JOYPAD_L);
+  case Field::Pad_r_bumper:     return button(p, RETRO_DEVICE_ID_JOYPAD_R);
+  case Field::Pad_l_trigger:    return analogButton(p, RETRO_DEVICE_ID_JOYPAD_L2);
+  case Field::Pad_r_trigger:    return analogButton(p, RETRO_DEVICE_ID_JOYPAD_R2);
+  case Field::Pad_lstick_click: return button(p, RETRO_DEVICE_ID_JOYPAD_L3);
+  case Field::Pad_rstick_click: return button(p, RETRO_DEVICE_ID_JOYPAD_R3);
+  case Field::Pad_lstick_up:    return stick(p, RETRO_DEVICE_INDEX_ANALOG_LEFT,  RETRO_DEVICE_ID_ANALOG_Y, -1);
+  case Field::Pad_lstick_down:  return stick(p, RETRO_DEVICE_INDEX_ANALOG_LEFT,  RETRO_DEVICE_ID_ANALOG_Y, +1);
+  case Field::Pad_lstick_left:  return stick(p, RETRO_DEVICE_INDEX_ANALOG_LEFT,  RETRO_DEVICE_ID_ANALOG_X, -1);
+  case Field::Pad_lstick_right: return stick(p, RETRO_DEVICE_INDEX_ANALOG_LEFT,  RETRO_DEVICE_ID_ANALOG_X, +1);
+  case Field::Pad_rstick_up:    return stick(p, RETRO_DEVICE_INDEX_ANALOG_RIGHT, RETRO_DEVICE_ID_ANALOG_Y, -1);
+  case Field::Pad_rstick_down:  return stick(p, RETRO_DEVICE_INDEX_ANALOG_RIGHT, RETRO_DEVICE_ID_ANALOG_Y, +1);
+  case Field::Pad_rstick_left:  return stick(p, RETRO_DEVICE_INDEX_ANALOG_RIGHT, RETRO_DEVICE_ID_ANALOG_X, -1);
+  case Field::Pad_rstick_right: return stick(p, RETRO_DEVICE_INDEX_ANALOG_RIGHT, RETRO_DEVICE_ID_ANALOG_X, +1);
+  //numeric keypads (ColecoVision, Atari 5200, NTT Data Keypad) have no RetroPad
+  //equivalent; they read the keyboard's number row or numeric keypad
+  case Field::Pad_one:   return key(RETROK_1, RETROK_KP1);
+  case Field::Pad_two:   return key(RETROK_2, RETROK_KP2);
+  case Field::Pad_three: return key(RETROK_3, RETROK_KP3);
+  case Field::Pad_four:  return key(RETROK_4, RETROK_KP4);
+  case Field::Pad_five:  return key(RETROK_5, RETROK_KP5);
+  case Field::Pad_six:   return key(RETROK_6, RETROK_KP6);
+  case Field::Pad_seven: return key(RETROK_7, RETROK_KP7);
+  case Field::Pad_eight: return key(RETROK_8, RETROK_KP8);
+  case Field::Pad_nine:  return key(RETROK_9, RETROK_KP9);
+  case Field::Pad_zero:  return key(RETROK_0, RETROK_KP0);
+  case Field::Pad_star:  return key(RETROK_KP_MULTIPLY, RETROK_MINUS);
+  case Field::Pad_pound: return key(RETROK_KP_DIVIDE, RETROK_EQUALS);
+  case Field::Pad_clear: return key(RETROK_BACKSPACE);
+  case Field::Pad_point: return key(RETROK_PERIOD, RETROK_KP_PERIOD);
+  case Field::Pad_end:   return key(RETROK_END, RETROK_KP_ENTER);
+  case Field::Mouse_left:   return mouse(p, RETRO_DEVICE_ID_MOUSE_LEFT);
+  case Field::Mouse_middle: return mouse(p, RETRO_DEVICE_ID_MOUSE_MIDDLE);
+  case Field::Mouse_right:  return mouse(p, RETRO_DEVICE_ID_MOUSE_RIGHT);
+  case Field::Mouse_extra:  return mouse(p, RETRO_DEVICE_ID_MOUSE_BUTTON_4);
+  default: return 0;
+  }
+}
+
+auto relative(Binding& binding, Field field) -> s64 {
+  //the frontend reports motion since the previous input_poll; ares may poll an axis several
+  //times per frame, so only hand out the delta once per frame
+  if(binding.lastRelativeFrame == frameCounter) return 0;
+  binding.lastRelativeFrame = frameCounter;
+  if(field == Field::Mouse_x) return input_state_cb(binding.player, RETRO_DEVICE_MOUSE, 0, RETRO_DEVICE_ID_MOUSE_X);
+  if(field == Field::Mouse_y) return input_state_cb(binding.player, RETRO_DEVICE_MOUSE, 0, RETRO_DEVICE_ID_MOUSE_Y);
+  return 0;
+}
+
+auto resolve(ares::Node::Input::Input node) -> Binding* {
+  auto key = (const void*)node.get();
+  if(auto it = cache.find(key); it != cache.end()) return &it->second;
+
+  Binding binding;
+  auto device = ares::Node::parent(node);
+  if(device) {
+    auto port = ares::Node::parent(device);
+    binding.player = port ? playerForPort(port->name()) : 0;
+    binding.input = findInput(findDevice(device->name()), node->name());
+    if(!binding.input) log(RETRO_LOG_DEBUG, {"unmapped input: ", device->name(), " / ", node->name()});
+  }
+  return &cache.emplace(key, binding).first->second;
+}
+
+auto deviceType(const Device* device) -> u32 {
+  for(u32 i = 0; i < device->count; i++) {
+    if(device->inputs[i].kind == Kind::Relative) return RETRO_DEVICE_MOUSE;
+  }
+  return RETRO_DEVICE_JOYPAD;
+}
+
+auto controllerPort(u32 index) -> ares::Node::Port {
+  if(!session.root || index >= session.controllerPorts.size()) return {};
+  return session.root->find<ares::Node::Port>(session.controllerPorts[index]);
+}
+
+auto connectMultitap(ares::Node::Port port) -> bool {
+  auto multitap = port->allocate("Super Multitap");
+  if(!multitap) return false;
+  u32 id = 0;
+  for(auto socket : ares::Node::enumerate<ares::Node::Port>(multitap)) {
+    string name{"Multitap Port ", ++id};
+    socket->setName(name);
+    socket->setSupported({"Gamepad"});
+    socket->allocate("Gamepad");
+    socket->connect();
+  }
+  port->connect();
+  return true;
+}
+
+}
+
+auto reset() -> void {
+  cache.clear();
+  for(auto& pad : pads) pad = {};
+  if(environ_cb) useBitmasks = environ_cb(RETRO_ENVIRONMENT_GET_INPUT_BITMASKS, nullptr);
+}
+
+auto frame() -> void {
+  frameCounter++;
+}
+
+auto poll(ares::Node::Input::Input node) -> void {
+  auto binding = resolve(node);
+  auto input = binding->input;
+  auto p = binding->player;
+
+  if(auto button = node->cast<ares::Node::Input::Button>()) {
+    button->setValue(input ? magnitude(p, input->a) > 16384 : false);
+    return;
+  }
+
+  if(auto axis = node->cast<ares::Node::Input::Axis>()) {
+    if(!input) return axis->setValue(0);
+    if(input->kind == Kind::Relative) return axis->setValue(relative(*binding, input->a));
+    s64 value = input->b != Field::None ? magnitude(p, input->b) - magnitude(p, input->a) : magnitude(p, input->a);
+    return axis->setValue(sclamp<16>(value));
+  }
+
+  if(auto trigger = node->cast<ares::Node::Input::Trigger>()) {
+    trigger->setValue(input ? magnitude(p, input->a) : 0);
+    return;
+  }
+
+  if(auto rumble = node->cast<ares::Node::Input::Rumble>()) {
+    if(rumble_cb) {
+      rumble_cb(p, RETRO_RUMBLE_STRONG, rumble->strongValue());
+      rumble_cb(p, RETRO_RUMBLE_WEAK, rumble->weakValue());
+    }
+    return;
+  }
+}
+
+//build the per-port device lists from what each ares port supports
+auto setControllerInfo() -> void {
+  portDevices.clear();
+  controllerDescriptions.clear();
+  controllerInfo.clear();
+
+  u32 ports = session.controllerPorts.size();
+  for(u32 index = 0; index < ports; index++) {
+    std::vector<PortDevice> list;
+    auto port = controllerPort(index);
+    auto fallback = index < session.defaultDevices.size() ? session.defaultDevices[index] : string{};
+    list.push_back({RETRO_DEVICE_JOYPAD, fallback ? string{"Default (", fallback, ")"} : string{"Default"}});
+    if(port) {
+      u32 sub = 0;
+      for(auto& name : port->supported()) {
+        sub++;
+        if(name == "Super Multitap") {
+          list.push_back({RETRO_DEVICE_SUBCLASS(RETRO_DEVICE_JOYPAD, sub), name});
+          continue;
+        }
+        auto device = findDevice(name);
+        if(!device) continue;
+        list.push_back({RETRO_DEVICE_SUBCLASS(deviceType(device), sub), name});
+      }
+    }
+    list.push_back({RETRO_DEVICE_NONE, "None"});
+    portDevices.push_back(list);
+  }
+
+  //descriptions must outlive the call, so size the backing vector first
+  u32 total = 0;
+  for(auto& list : portDevices) total += list.size();
+  controllerDescriptions.reserve(total);
+  for(auto& list : portDevices) {
+    u32 first = controllerDescriptions.size();
+    for(auto& entry : list) controllerDescriptions.push_back({(const char*)entry.name, entry.id});
+    controllerInfo.push_back({&controllerDescriptions[first], (u32)list.size()});
+  }
+  controllerInfo.push_back({nullptr, 0});
+  if(ports) environ_cb(RETRO_ENVIRONMENT_SET_CONTROLLER_INFO, controllerInfo.data());
+
+  //apply selections the frontend made before the game was loaded
+  for(u32 index = 0; index < requestedDevices.size() && index < ports; index++) {
+    if(requestedDevices[index] != RETRO_DEVICE_JOYPAD) setPortDevice(index, requestedDevices[index]);
+  }
+}
+
+auto setPortDevice(u32 index, u32 id) -> void {
+  if(!session.root) {
+    if(requestedDevices.size() <= index) requestedDevices.resize(index + 1, RETRO_DEVICE_JOYPAD);
+    requestedDevices[index] = id;
+    return;
+  }
+  if(index >= portDevices.size()) return;
+  auto port = controllerPort(index);
+  if(!port) return;
+
+  string name;
+  if(id == RETRO_DEVICE_JOYPAD) name = index < session.defaultDevices.size() ? session.defaultDevices[index] : string{};
+  else if(id != RETRO_DEVICE_NONE) {
+    for(auto& entry : portDevices[index]) if(entry.id == id) name = entry.name;
+    if(!name) return;  //unknown id: ignore
+  }
+
+  auto connected = port->connected();
+  if(!name) {
+    if(connected) port->disconnect();
+  } else if(!connected || connected->name() != name) {
+    port->disconnect();
+    if(name == "Super Multitap") connectMultitap(port);
+    else if(port->allocate(name)) port->connect();
+  }
+  cache.clear();
+  setDescriptors();
+}
+
+//tell the frontend what each RetroPad button does on the connected devices
+auto setDescriptors() -> void {
+  descriptors.clear();
+  descriptorNames.clear();
+
+  auto describe = [&](u32 player, const Device* device) {
+    if(!device) return;
+    for(u32 i = 0; i < device->count; i++) {
+      auto& input = device->inputs[i];
+      retro_input_descriptor d{player, RETRO_DEVICE_JOYPAD, 0, 0, nullptr};
+      bool ok = true;
+      if(input.kind == Kind::Analog && input.b != Field::None) {
+        d.device = RETRO_DEVICE_ANALOG;
+        bool right = input.a == Field::Pad_rstick_left || input.a == Field::Pad_rstick_up;
+        d.index = right ? RETRO_DEVICE_INDEX_ANALOG_RIGHT : RETRO_DEVICE_INDEX_ANALOG_LEFT;
+        d.id = input.a == Field::Pad_lstick_left || input.a == Field::Pad_rstick_left ? RETRO_DEVICE_ID_ANALOG_X : RETRO_DEVICE_ID_ANALOG_Y;
+      } else if(input.kind == Kind::Digital || input.kind == Kind::Absolute) {
+        switch(input.a) {
+        case Field::Pad_up:           d.id = RETRO_DEVICE_ID_JOYPAD_UP; break;
+        case Field::Pad_down:         d.id = RETRO_DEVICE_ID_JOYPAD_DOWN; break;
+        case Field::Pad_left:         d.id = RETRO_DEVICE_ID_JOYPAD_LEFT; break;
+        case Field::Pad_right:        d.id = RETRO_DEVICE_ID_JOYPAD_RIGHT; break;
+        case Field::Pad_select:       d.id = RETRO_DEVICE_ID_JOYPAD_SELECT; break;
+        case Field::Pad_start:        d.id = RETRO_DEVICE_ID_JOYPAD_START; break;
+        case Field::Pad_south:        d.id = RETRO_DEVICE_ID_JOYPAD_B; break;
+        case Field::Pad_east:         d.id = RETRO_DEVICE_ID_JOYPAD_A; break;
+        case Field::Pad_west:         d.id = RETRO_DEVICE_ID_JOYPAD_Y; break;
+        case Field::Pad_north:        d.id = RETRO_DEVICE_ID_JOYPAD_X; break;
+        case Field::Pad_l_bumper:     d.id = RETRO_DEVICE_ID_JOYPAD_L; break;
+        case Field::Pad_r_bumper:     d.id = RETRO_DEVICE_ID_JOYPAD_R; break;
+        case Field::Pad_l_trigger:    d.id = RETRO_DEVICE_ID_JOYPAD_L2; break;
+        case Field::Pad_r_trigger:    d.id = RETRO_DEVICE_ID_JOYPAD_R2; break;
+        case Field::Pad_lstick_click: d.id = RETRO_DEVICE_ID_JOYPAD_L3; break;
+        case Field::Pad_rstick_click: d.id = RETRO_DEVICE_ID_JOYPAD_R3; break;
+        default: ok = false;
+        }
+      } else ok = false;
+      if(!ok) continue;
+      descriptorNames.push_back(input.name);
+      d.description = descriptorNames.back();
+      descriptors.push_back(d);
+    }
+  };
+
+  if(session.controllerPorts.empty()) {
+    //handhelds: the system node itself owns the controls
+    if(auto table = systemTable(); table && table->count) describe(0, &table->devices[0]);
+  } else {
+    for(u32 index = 0; index < session.controllerPorts.size(); index++) {
+      auto port = controllerPort(index);
+      if(!port) continue;
+      auto connected = port->connected();
+      if(!connected) continue;
+      if(connected->name() == "Super Multitap") {
+        for(u32 n = 1; n <= 4; n++) describe(n, findDevice("Gamepad"));
+        continue;
+      }
+      describe(index, findDevice(connected->name()));
+    }
+  }
+  descriptors.push_back({0, 0, 0, 0, nullptr});
+  environ_cb(RETRO_ENVIRONMENT_SET_INPUT_DESCRIPTORS, descriptors.data());
+}
+
+}
diff --git a/libretro/libretro.cpp b/libretro/libretro.cpp
new file mode 100644
index 0000000..412da2d
--- /dev/null
+++ b/libretro/libretro.cpp
@@ -0,0 +1,579 @@
+#include "core.hpp"
+#include "input-map.hpp"
+#include "options.cpp"
+#include "input.cpp"
+#include "systems.cpp"
+
+#include <cmath>
+
+//nall/main.cpp (linked in with the rest of nall) expects the program to define this
+namespace nall { auto main(Arguments) -> void {} }
+
+namespace ares_libretro {
+
+static constexpr f64 SampleRate = 48000.0;
+
+//------------------------------------------------------------------------------
+//ares::Platform implementation
+
+struct Frontend : ares::Platform {
+  std::vector<ares::Node::Video::Screen> screens;
+  std::vector<ares::Node::Audio::Stream> streams;
+
+  //video
+  std::vector<u32> frame;
+  u32 frameWidth = 0;
+  u32 frameHeight = 0;
+  bool frameReady = false;
+  f64 aspect = 4.0 / 3.0;
+  bool squarePixels = false;
+
+  //timing
+  f64 refreshRate = 0.0;
+  bool refreshChanged = false;
+
+  //audio
+  std::vector<s16> samples;
+
+  auto attach(ares::Node::Object node) -> void override {
+    if(auto screen = node->cast<ares::Node::Video::Screen>()) {
+      if(std::ranges::find(screens, screen) == screens.end()) screens.push_back(screen);
+    }
+    if(auto stream = node->cast<ares::Node::Audio::Stream>()) {
+      if(std::ranges::find(streams, stream) == streams.end()) streams.push_back(stream);
+      stream->setResamplerFrequency(SampleRate);
+    }
+  }
+
+  auto detach(ares::Node::Object node) -> void override {
+    if(auto screen = node->cast<ares::Node::Video::Screen>()) std::erase(screens, screen);
+    if(auto stream = node->cast<ares::Node::Audio::Stream>()) std::erase(streams, stream);
+  }
+
+  auto pak(ares::Node::Object node) -> std::shared_ptr<vfs::directory> override {
+    return session.pak(node);
+  }
+
+  auto event(ares::Event) -> void override {}
+
+  auto log(ares::Node::Debugger::Tracer::Tracer node, string_view message) -> void override {
+    if(log_cb) log_cb(RETRO_LOG_DEBUG, "[ares] %s: %.*s\n", (const char*)node->name(), (int)message.size(), message.data());
+  }
+
+  auto status(string_view message) -> void override {
+    ares_libretro::log(RETRO_LOG_INFO, string{message});
+  }
+
+  auto video(ares::Node::Video::Screen node, const u32* data, u32 pitch, u32 width, u32 height) -> void override {
+    //multi-screen systems are not supported by libretro; present the first screen
+    if(!screens.empty() && node != screens.front()) return;
+    if(!width || !height) return;
+
+    frame.resize(width * height);
+    pitch >>= 2;
+    for(u32 y = 0; y < height; y++) {
+      memory::copy<u32>(frame.data() + y * width, data + y * pitch, width);
+    }
+    frameWidth = width;
+    frameHeight = height;
+    frameReady = true;
+
+    aspect = aspectOf(node, width, height);
+  }
+
+  //display aspect ratio, computed the way desktop-ui sizes its output
+  auto aspectOf(ares::Node::Video::Screen node, u32 width, u32 height) const -> f64 {
+    f64 videoWidth  = node->width()  * node->scaleX();
+    f64 videoHeight = node->height() * node->scaleY();
+    if(!squarePixels) videoWidth = videoWidth * node->aspectX() / node->aspectY();
+    else videoWidth = width, videoHeight = height;
+    if(node->rotation() == 90 || node->rotation() == 270) std::swap(videoWidth, videoHeight);
+    if(videoWidth > 0 && videoHeight > 0) return videoWidth / videoHeight;
+    return 4.0 / 3.0;
+  }
+
+  auto refreshRateHint(double rate) -> void override {
+    if(rate < 1.0 || rate > 500.0) return;
+    if(std::abs(rate - refreshRate) > 0.0005) {
+      refreshRate = rate;
+      refreshChanged = true;
+    }
+  }
+
+  auto audio(ares::Node::Audio::Stream) -> void override {
+    if(streams.empty()) return;
+    while(true) {
+      for(auto& stream : streams) if(!stream->pending()) return;
+      f64 mix[2] = {0.0, 0.0};
+      for(auto& stream : streams) {
+        f64 buffer[2];
+        u32 channels = stream->read(buffer);
+        if(channels == 1) {
+          mix[0] += buffer[0];
+          mix[1] += buffer[0];
+        } else {
+          mix[0] += buffer[0];
+          mix[1] += buffer[1];
+        }
+      }
+      for(auto c : range(2)) {
+        f64 v = max(-1.0, min(+1.0, mix[c]));
+        samples.push_back((s16)std::lround(v * 32767.0));
+      }
+    }
+  }
+
+  auto input(ares::Node::Input::Input node) -> void override {
+    input::poll(node);
+  }
+
+  auto reset() -> void {
+    screens.clear();
+    streams.clear();
+    frame.clear();
+    frameWidth = frameHeight = 0;
+    frameReady = false;
+    aspect = 4.0 / 3.0;
+    refreshRate = 0.0;
+    refreshChanged = false;
+    samples.clear();
+  }
+};
+
+static Frontend frontend;
+
+//------------------------------------------------------------------------------
+//helpers
+
+static bool contentLoaded = false;
+static bool canDupe = false;
+static u32 stateSize = 0;
+static retro_system_av_info lastAvInfo{};
+
+static auto applyVideoOptions() -> void {
+  if(!session.root) return;
+  auto setBoolean = [&](const char* name, bool value) {
+    if(auto node = session.root->scan<ares::Node::Setting::Boolean>(name)) {
+      node->setValue(value);
+      node->modify(value);
+    }
+  };
+  setBoolean("Color Emulation", option::enabled("ares_color_emulation", true));
+  setBoolean("Interframe Blending", option::enabled("ares_interframe_blending", true));
+  setBoolean("Deep Black Boost", option::enabled("ares_sfc_deep_black_boost"));
+
+  bool overscan = option::enabled("ares_overscan", true);
+  bool colorBleed = option::enabled("ares_color_bleed");
+  auto deinterlace = option::get("ares_deinterlace", "Weave");
+  bool n64 = session.desc && string{session.desc->name} == "Nintendo 64";
+  for(auto& screen : frontend.screens) {
+    screen->setOverscan(overscan);
+    screen->setColorBleed(screen->height() < 720 ? colorBleed : false);
+    if(!n64) screen->setDeinterlace(deinterlace);
+  }
+  frontend.squarePixels = option::get("ares_aspect", "standard") == "square";
+}
+
+static auto maxGeometry(u32& width, u32& height) -> void {
+  width = height = 0;
+  for(auto& screen : frontend.screens) {
+    u32 w = screen->canvasWidth(), h = screen->canvasHeight();
+    //rotated systems swap the output dimensions
+    width = max(width, max(w, h));
+    height = max(height, max(w, h));
+  }
+  width = max(width, frontend.frameWidth);
+  height = max(height, frontend.frameHeight);
+  if(!width) width = 640;
+  if(!height) height = 480;
+}
+
+static auto fillAvInfo(retro_system_av_info* info) -> void {
+  *info = {};
+  u32 maxWidth, maxHeight;
+  maxGeometry(maxWidth, maxHeight);
+  u32 baseWidth = frontend.frameWidth, baseHeight = frontend.frameHeight;
+  if(!baseWidth || !baseHeight) {
+    if(!frontend.screens.empty()) {
+      baseWidth = frontend.screens.front()->width();
+      baseHeight = frontend.screens.front()->height();
+    }
+    if(!baseWidth || !baseHeight) baseWidth = 320, baseHeight = 240;
+    if(!frontend.screens.empty()) frontend.aspect = frontend.aspectOf(frontend.screens.front(), baseWidth, baseHeight);
+  }
+  info->geometry.base_width = baseWidth;
+  info->geometry.base_height = baseHeight;
+  info->geometry.max_width = maxWidth;
+  info->geometry.max_height = maxHeight;
+  info->geometry.aspect_ratio = (float)frontend.aspect;
+  f64 fps = frontend.refreshRate;
+  if(fps <= 0.0) {
+    fps = session.desc ? session.desc->defaultFps : 60.0;
+    if(session.region.find("PAL")) fps = 50.0;
+  }
+  info->timing.fps = fps;
+  info->timing.sample_rate = SampleRate;
+}
+
+static auto flushAudio() -> void {
+  auto& s = frontend.samples;
+  u32 frames = s.size() / 2;
+  const s16* data = s.data();
+  while(frames) {
+    u32 chunk = min(frames, 2048u);
+    u32 written = audio_batch_cb(data, chunk);
+    if(!written) break;
+    data += written * 2;
+    frames -= written;
+  }
+  s.clear();
+}
+
+//------------------------------------------------------------------------------
+//disk control: Famicom Disk System side switching
+
+static auto diskState() -> ares::Node::Setting::String {
+  if(!session.root) return {};
+  return session.root->scan<ares::Node::Setting::String>("State");
+}
+
+static auto diskImages() -> std::vector<string> {
+  std::vector<string> images;
+  if(auto state = diskState()) {
+    for(auto& value : state->readAllowedValues()) if(value != "Ejected") images.push_back(value);
+  }
+  return images;
+}
+
+static u32 diskIndex = 0;
+
+static auto setDiskValue(const string& value) -> bool {
+  auto state = diskState();
+  if(!state) return false;
+  state->setValue(value);
+  state->modify(value);
+  return true;
+}
+
+static bool RETRO_CALLCONV disk_set_eject_state(bool ejected) {
+  auto images = diskImages();
+  if(ejected) return setDiskValue("Ejected");
+  if(diskIndex >= images.size()) return false;
+  return setDiskValue(images[diskIndex]);
+}
+
+static bool RETRO_CALLCONV disk_get_eject_state() {
+  auto state = diskState();
+  return !state || state->value() == "Ejected";
+}
+
+static unsigned RETRO_CALLCONV disk_get_image_index() { return diskIndex; }
+
+static bool RETRO_CALLCONV disk_set_image_index(unsigned index) {
+  auto images = diskImages();
+  if(index >= images.size()) return false;
+  diskIndex = index;
+  if(!disk_get_eject_state()) return setDiskValue(images[index]);
+  return true;
+}
+
+static unsigned RETRO_CALLCONV disk_get_num_images() { return diskImages().size(); }
+static bool RETRO_CALLCONV disk_replace_image_index(unsigned, const retro_game_info*) { return false; }
+static bool RETRO_CALLCONV disk_add_image_index() { return false; }
+
+static bool RETRO_CALLCONV disk_get_image_label(unsigned index, char* label, size_t length) {
+  auto images = diskImages();
+  if(index >= images.size() || !label || !length) return false;
+  snprintf(label, length, "%s", (const char*)images[index]);
+  return true;
+}
+
+static auto setupDiskControl() -> void {
+  diskIndex = 0;
+  auto images = diskImages();
+  if(images.empty()) return;
+  if(auto state = diskState()) {
+    for(u32 i = 0; i < images.size(); i++) if(images[i] == state->value()) diskIndex = i;
+  }
+  static retro_disk_control_ext_callback ext{
+    disk_set_eject_state, disk_get_eject_state, disk_get_image_index, disk_set_image_index,
+    disk_get_num_images, disk_replace_image_index, disk_add_image_index,
+    nullptr, nullptr, disk_get_image_label,
+  };
+  if(environ_cb(RETRO_ENVIRONMENT_SET_DISK_CONTROL_EXT_INTERFACE, &ext)) return;
+  static retro_disk_control_callback basic{
+    disk_set_eject_state, disk_get_eject_state, disk_get_image_index, disk_set_image_index,
+    disk_get_num_images, disk_replace_image_index, disk_add_image_index,
+  };
+  environ_cb(RETRO_ENVIRONMENT_SET_DISK_CONTROL_INTERFACE, &basic);
+}
+
+static auto unloadSession() -> void {
+  if(session.root) {
+    session.save();
+    session.root->unload();
+  }
+  session = {};
+  frontend.reset();
+  input::reset();
+  contentLoaded = false;
+  stateSize = 0;
+}
+
+static auto frontendDirectory(u32 id) -> string {
+  const char* dir = nullptr;
+  if(environ_cb(id, &dir) && dir && *dir) {
+    string path = dir;
+    path.transform("\\", "/");
+    if(!path.endsWith("/")) path.append("/");
+    return path;
+  }
+  return {};
+}
+
+}
+
+using namespace ares_libretro;
+
+//------------------------------------------------------------------------------
+//libretro API
+
+RETRO_API unsigned retro_api_version() { return RETRO_API_VERSION; }
+
+RETRO_API void retro_set_environment(retro_environment_t cb) {
+  environ_cb = cb;
+  retro_log_callback logging{};
+  if(environ_cb(RETRO_ENVIRONMENT_GET_LOG_INTERFACE, &logging)) log_cb = logging.log;
+  bool noGame = false;
+  environ_cb(RETRO_ENVIRONMENT_SET_SUPPORT_NO_GAME, &noGame);
+  option::install();
+}
+
+RETRO_API void retro_set_video_refresh(retro_video_refresh_t cb) { video_cb = cb; }
+RETRO_API void retro_set_audio_sample(retro_audio_sample_t cb) { audio_cb = cb; }
+RETRO_API void retro_set_audio_sample_batch(retro_audio_sample_batch_t cb) { audio_batch_cb = cb; }
+RETRO_API void retro_set_input_poll(retro_input_poll_t cb) { input_poll_cb = cb; }
+RETRO_API void retro_set_input_state(retro_input_state_t cb) { input_state_cb = cb; }
+
+RETRO_API void retro_init() {
+  auto system = frontendDirectory(RETRO_ENVIRONMENT_GET_SYSTEM_DIRECTORY);
+  auto saves = frontendDirectory(RETRO_ENVIRONMENT_GET_SAVE_DIRECTORY);
+  if(!saves) saves = system;
+  paths.systemBase = system;
+  paths.system = system ? string{system, "ares/"} : string{};
+  paths.saves = saves ? string{saves, "ares/"} : string{};
+
+  //ares/mia data files (Database/*.bml) are looked up in system/ares/ first
+  mia::setResourceLocation([](const string& name) -> string {
+    return paths.system ? string{paths.system, name} : string{};
+  });
+  //system paks (eg internal save memory) and cartridge saves live under saves/ares/
+  if(paths.saves) {
+    mia::setHomeLocation([] { return paths.saves; });
+    mia::setSaveLocation([] { return paths.saves; });
+  }
+
+  ares::platform = &frontend;
+  canDupe = false;
+  environ_cb(RETRO_ENVIRONMENT_GET_CAN_DUPE, &canDupe);
+  input::reset();
+}
+
+RETRO_API void retro_deinit() {
+  unloadSession();
+  ares::platform = nullptr;
+}
+
+RETRO_API void retro_get_system_info(retro_system_info* info) {
+  static string version;
+  static string extensions;
+  if(!version) version = {ares::Version, " (libretro)"};
+  if(!extensions) {
+    std::vector<string> list{"cue", "chd", "bin", "zip"};
+    for(auto& s : systems()) {
+      for(auto& e : s.extensions) if(std::ranges::find(list, e) == list.end()) list.push_back(e);
+    }
+    for(auto& e : list) extensions.append(extensions ? "|" : "", e);
+  }
+  *info = {};
+  info->library_name = "ares";
+  info->library_version = version;
+  info->valid_extensions = extensions;
+  info->need_fullpath = true;   //mia reads images (and companion files like .cue tracks) from disk
+  info->block_extract = true;   //mia understands .zip itself, and uses the inner file name to identify it
+}
+
+RETRO_API void retro_get_system_av_info(retro_system_av_info* info) {
+  fillAvInfo(info);
+  lastAvInfo = *info;
+}
+
+RETRO_API void retro_set_controller_port_device(unsigned port, unsigned device) {
+  input::setPortDevice(port, device);
+}
+
+RETRO_API void retro_reset() {
+  if(!session.root) return;
+  session.save();
+  session.root->power(true);
+}
+
+RETRO_API void retro_run() {
+  if(!session.root) return;
+
+  if(option::updated()) applyVideoOptions();
+
+  input_poll_cb();
+  input::frame();
+
+  //every ares core returns from System::run() once per emulated frame: scheduler-based
+  //cores exit on Event::Frame, and N64's CPU::main() loops until the VI refreshes. A frame
+  //period can pass without new video (eg an Atari 2600 game that stops issuing VSYNC), in
+  //which case the previous frame is repeated below.
+  frontend.frameReady = false;
+  session.root->run();
+
+  flushAudio();
+
+  if(frontend.refreshChanged) {
+    frontend.refreshChanged = false;
+    retro_system_av_info info;
+    fillAvInfo(&info);
+    if(std::abs(info.timing.fps - lastAvInfo.timing.fps) > 0.0005
+    || info.geometry.max_width > lastAvInfo.geometry.max_width
+    || info.geometry.max_height > lastAvInfo.geometry.max_height) {
+      environ_cb(RETRO_ENVIRONMENT_SET_SYSTEM_AV_INFO, &info);
+      lastAvInfo = info;
+    }
+  }
+
+  if(frontend.frameReady) {
+    auto& g = lastAvInfo.geometry;
+    if(frontend.frameWidth > g.max_width || frontend.frameHeight > g.max_height) {
+      retro_system_av_info info;
+      fillAvInfo(&info);
+      environ_cb(RETRO_ENVIRONMENT_SET_SYSTEM_AV_INFO, &info);
+      lastAvInfo = info;
+    } else if(frontend.frameWidth != g.base_width || frontend.frameHeight != g.base_height
+           || std::abs(frontend.aspect - g.aspect_ratio) > 0.0001) {
+      g.base_width = frontend.frameWidth;
+      g.base_height = frontend.frameHeight;
+      g.aspect_ratio = (float)frontend.aspect;
+      environ_cb(RETRO_ENVIRONMENT_SET_GEOMETRY, &g);
+    }
+    video_cb(frontend.frame.data(), frontend.frameWidth, frontend.frameHeight, frontend.frameWidth * sizeof(u32));
+  } else if(canDupe) {
+    video_cb(nullptr, lastAvInfo.geometry.base_width, lastAvInfo.geometry.base_height, 0);
+  } else if(!frontend.frame.empty()) {
+    video_cb(frontend.frame.data(), frontend.frameWidth, frontend.frameHeight, frontend.frameWidth * sizeof(u32));
+  }
+}
+
+//save states ------------------------------------------------------------------
+
+static auto synchronizeStates() -> bool {
+  //run-ahead and netplay rollback want fast states; ordinary save states want ares to
+  //bring all of its threads to a clean synchronization point first, as desktop-ui does
+  int context = RETRO_SAVESTATE_CONTEXT_NORMAL;
+  if(environ_cb(RETRO_ENVIRONMENT_GET_SAVESTATE_CONTEXT, &context)) {
+    return context == RETRO_SAVESTATE_CONTEXT_NORMAL;
+  }
+  return true;
+}
+
+RETRO_API size_t retro_serialize_size() {
+  if(!session.root) return 0;
+  if(!stateSize) {
+    auto state = session.root->serialize(false);
+    //small margin in case a later state is a little larger (ares states are nearly fixed-size)
+    stateSize = state.size() + 4_KiB;
+  }
+  return stateSize;
+}
+
+RETRO_API bool retro_serialize(void* data, size_t size) {
+  if(!session.root || !data) return false;
+  auto state = session.root->serialize(synchronizeStates());
+  if(!state.size() || state.size() > size) return false;
+  memory::copy(data, state.data(), state.size());
+  if(size > state.size()) memory::fill((u8*)data + state.size(), size - state.size());
+  return true;
+}
+
+RETRO_API bool retro_unserialize(const void* data, size_t size) {
+  if(!session.root || !data || !size) return false;
+  serializer state{(const u8*)data, (u32)size};
+  return session.root->unserialize(state);
+}
+
+RETRO_API void retro_cheat_reset() {}
+RETRO_API void retro_cheat_set(unsigned, bool, const char*) {}
+
+//content ----------------------------------------------------------------------
+
+RETRO_API bool retro_load_game(const retro_game_info* game) {
+  unloadSession();
+  if(!game || !game->path) {
+    notify("ares needs a game file to start.", 300, RETRO_LOG_ERROR);
+    return false;
+  }
+
+  retro_pixel_format format = RETRO_PIXEL_FORMAT_XRGB8888;
+  if(!environ_cb(RETRO_ENVIRONMENT_SET_PIXEL_FORMAT, &format)) {
+    log(RETRO_LOG_ERROR, "frontend does not support XRGB8888");
+    return false;
+  }
+
+  if(!paths.system) {
+    log(RETRO_LOG_WARN, "frontend did not provide a system directory; firmware and databases cannot be found");
+  }
+
+  session.location = game->path;
+  session.location.transform("\\", "/");
+
+  auto forced = option::get("ares_system", "auto");
+  const SystemDesc* desc = forced != "auto" ? findSystem(forced) : detectSystem(session.location);
+  if(!desc) {
+    notify({"ares could not identify a system for ", Location::file(session.location)}, 600, RETRO_LOG_ERROR);
+    return false;
+  }
+  session.desc = desc;
+  log(RETRO_LOG_INFO, {"loading ", Location::file(session.location), " as ", desc->name});
+
+  if(!desc->load(session)) {
+    unloadSession();
+    return false;
+  }
+
+  applyVideoOptions();
+  input::reset();
+  input::setControllerInfo();
+  input::setDescriptors();
+
+  retro_rumble_interface rumble{};
+  rumble_cb = environ_cb(RETRO_ENVIRONMENT_GET_RUMBLE_INTERFACE, &rumble) ? rumble.set_rumble_state : nullptr;
+
+  //boot animation skipping (PlayStation, Game Boy, ...) is latched at power-on
+  for(auto& fastBoot : session.root->find<ares::Node::Setting::Boolean>()) {
+    if(fastBoot->name() == "Fast Boot") fastBoot->setValue(option::enabled("ares_fast_boot"));
+  }
+
+  session.root->power();
+  setupDiskControl();
+
+  contentLoaded = true;
+  log(RETRO_LOG_INFO, {desc->name, " ready (region: ", session.region ? session.region : string{"default"}, ")"});
+  return true;
+}
+
+RETRO_API bool retro_load_game_special(unsigned, const retro_game_info*, size_t) { return false; }
+
+RETRO_API void retro_unload_game() { unloadSession(); }
+
+RETRO_API unsigned retro_get_region() {
+  return session.region.find("PAL") ? RETRO_REGION_PAL : RETRO_REGION_NTSC;
+}
+
+//ares writes its own save files (to saves/ares/), so no memory is exposed for .srm
+RETRO_API void* retro_get_memory_data(unsigned) { return nullptr; }
+RETRO_API size_t retro_get_memory_size(unsigned) { return 0; }
