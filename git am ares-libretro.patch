diff --git a/libretro/options.cpp b/libretro/options.cpp
new file mode 100644
index 0000000..189bb72
--- /dev/null
+++ b/libretro/options.cpp
@@ -0,0 +1,163 @@
+//core options, exposed through the libretro core options v2 API (with a v0 fallback)
+
+namespace ares_libretro::option {
+
+namespace {
+
+struct Def {
+  const char* key;
+  const char* desc;
+  const char* info;
+  const char* category;
+  std::vector<std::pair<const char*, const char*>> values;  //value, label
+  const char* fallback;
+};
+
+//filled from systems() so the "force system" list always matches what is compiled in
+auto definitions() -> std::vector<Def>& {
+  static std::vector<Def> defs;
+  if(!defs.empty()) return defs;
+
+  Def system{"ares_system", "Force System (restart)",
+    "Which emulated system to start. 'Auto' picks from the file extension and contents.",
+    "system", {{"auto", "Auto"}}, "auto"};
+  for(auto& s : systems()) system.values.push_back({s.name, s.name});
+
+  defs = {
+    system,
+    {"ares_region", "Preferred Region (restart)",
+     "Region to boot when a game supports more than one.",
+     "system", {{"NTSC-U", "NTSC-U (America)"}, {"NTSC-J", "NTSC-J (Japan)"}, {"PAL", "PAL (Europe)"}}, "NTSC-U"},
+    {"ares_fast_boot", "Fast Boot (restart)",
+     "Skip the console boot animation where the system supports it (eg PlayStation, Game Boy).",
+     "system", {{"disabled", nullptr}, {"enabled", nullptr}}, "disabled"},
+    {"ares_recompiler", "Dynamic Recompiler (restart)",
+     "Use the dynamic recompiler on systems that have one (N64, PlayStation, 32X). Disable to force the slower interpreter.",
+     "system", {{"enabled", nullptr}, {"disabled", nullptr}}, "enabled"},
+
+    {"ares_aspect", "Aspect Ratio",
+     "'Standard' applies each system's pixel aspect ratio, as ares does by default. 'Square Pixels' outputs 1:1 pixels.",
+     "video", {{"standard", "Standard"}, {"square", "Square Pixels"}}, "standard"},
+    {"ares_overscan", "Show Overscan Area",
+     "Show the full image area, including borders that televisions usually cropped.",
+     "video", {{"enabled", nullptr}, {"disabled", nullptr}}, "enabled"},
+    {"ares_color_emulation", "Color Emulation",
+     "Reproduce the color response of the original display hardware.",
+     "video", {{"enabled", nullptr}, {"disabled", nullptr}}, "enabled"},
+    {"ares_interframe_blending", "Interframe Blending",
+     "Blend consecutive frames to emulate LCD ghosting and flicker-based transparency effects.",
+     "video", {{"enabled", nullptr}, {"disabled", nullptr}}, "enabled"},
+    {"ares_color_bleed", "Color Bleed",
+     "Blur adjacent pixels horizontally to emulate composite video color bleed (sub-HD content only).",
+     "video", {{"disabled", nullptr}, {"enabled", nullptr}}, "disabled"},
+    {"ares_deinterlace", "Deinterlacing",
+     "How to present interlaced video modes.",
+     "video", {{"Weave", nullptr}, {"Bob", nullptr}, {"Blend", nullptr}, {"Phosphor", nullptr}}, "Weave"},
+    {"ares_pixel_accuracy", "Pixel Accuracy (restart)",
+     "Use the cycle-accurate renderer where one exists (Super Famicom, PC Engine, PlayStation, WonderSwan, GBA). Slower.",
+     "video", {{"disabled", nullptr}, {"enabled", nullptr}}, "disabled"},
+
+    {"ares_sfc_deep_black_boost", "Super Famicom: Deep Black Boost",
+     "Apply a gamma ramp to crush blacks, matching a CRT more closely.",
+     "systems", {{"disabled", nullptr}, {"enabled", nullptr}}, "disabled"},
+    {"ares_md_tmss", "Mega Drive: TMSS Boot Screen (restart)",
+     "Emulate the Trademark Security System boot screen.",
+     "systems", {{"disabled", nullptr}, {"enabled", nullptr}}, "disabled"},
+    {"ares_gba_player", "Game Boy Advance: Game Boy Player (restart)",
+     "Emulate the GameCube Game Boy Player, which enables rumble in supported games.",
+     "systems", {{"disabled", nullptr}, {"enabled", nullptr}}, "disabled"},
+    {"ares_n64_gpu", "Nintendo 64: GPU Acceleration (restart)",
+     "Render with paraLLEl-RDP on Vulkan. Requires a Vulkan driver; falls back to software rendering if unavailable.",
+     "systems", {{"enabled", nullptr}, {"disabled", nullptr}}, "enabled"},
+    {"ares_n64_quality", "Nintendo 64: Internal Resolution (restart)",
+     "Upscaling factor for GPU-accelerated rendering.",
+     "systems", {{"SD", "1x (SD)"}, {"HD", "2x (HD)"}, {"UHD", "4x (UHD)"}}, "SD"},
+    {"ares_n64_supersampling", "Nintendo 64: Supersampling (restart)",
+     "Downsample the upscaled image back to native resolution.",
+     "systems", {{"disabled", nullptr}, {"enabled", nullptr}}, "disabled"},
+    {"ares_n64_expansion_pak", "Nintendo 64: Expansion Pak (restart)",
+     "Install the 4MB Expansion Pak.",
+     "systems", {{"enabled", nullptr}, {"disabled", nullptr}}, "enabled"},
+  };
+  return defs;
+}
+
+std::vector<retro_core_option_v2_definition> v2;
+std::vector<string> v0strings;
+std::vector<retro_variable> v0;
+
+retro_core_option_v2_category categories[] = {
+  {"system",  "System",  "Boot, region and CPU emulation settings."},
+  {"video",   "Video",   "Image output and filtering."},
+  {"systems", "Per-System", "Settings that only affect one emulated system."},
+  {nullptr, nullptr, nullptr},
+};
+
+}
+
+auto install() -> void {
+  auto& defs = definitions();
+
+  u32 version = 0;
+  if(!environ_cb(RETRO_ENVIRONMENT_GET_CORE_OPTIONS_VERSION, &version)) version = 0;
+
+  if(version >= 2) {
+    v2.clear();
+    for(auto& d : defs) {
+      retro_core_option_v2_definition def{};
+      def.key = d.key;
+      def.desc = d.desc;
+      def.info = d.info;
+      def.category_key = d.category;
+      u32 n = 0;
+      for(auto& [value, label] : d.values) {
+        if(n >= RETRO_NUM_CORE_OPTION_VALUES_MAX - 1) break;
+        def.values[n++] = {value, label};
+      }
+      def.values[n] = {nullptr, nullptr};
+      def.default_value = d.fallback;
+      v2.push_back(def);
+    }
+    v2.push_back({});
+    static retro_core_options_v2 options;
+    options.categories = categories;
+    options.definitions = v2.data();
+    if(environ_cb(RETRO_ENVIRONMENT_SET_CORE_OPTIONS_V2, &options)) return;
+  }
+
+  //legacy frontends: "Description; default|other|other"
+  v0strings.clear();
+  v0.clear();
+  v0strings.reserve(defs.size());
+  for(auto& d : defs) {
+    string s = {d.desc, "; ", d.fallback};
+    for(auto& [value, label] : d.values) {
+      if(string{value} != d.fallback) s.append("|", value);
+    }
+    v0strings.push_back(s);
+  }
+  for(u32 i = 0; i < defs.size(); i++) v0.push_back({defs[i].key, v0strings[i]});
+  v0.push_back({nullptr, nullptr});
+  environ_cb(RETRO_ENVIRONMENT_SET_VARIABLES, v0.data());
+}
+
+auto get(const char* key, const char* fallback) -> string {
+  retro_variable var{key, nullptr};
+  if(environ_cb && environ_cb(RETRO_ENVIRONMENT_GET_VARIABLE, &var) && var.value) return var.value;
+  for(auto& d : definitions()) {
+    if(string{d.key} == key) return d.fallback;
+  }
+  return fallback;
+}
+
+auto enabled(const char* key, bool fallback) -> bool {
+  auto value = get(key, fallback ? "enabled" : "disabled");
+  return value == "enabled";
+}
+
+auto updated() -> bool {
+  bool changed = false;
+  return environ_cb && environ_cb(RETRO_ENVIRONMENT_GET_VARIABLE_UPDATE, &changed) && changed;
+}
+
+}
diff --git a/libretro/systems.cpp b/libretro/systems.cpp
new file mode 100644
index 0000000..fafe7f1
--- /dev/null
+++ b/libretro/systems.cpp
@@ -0,0 +1,843 @@
+//per-system loaders. These mirror desktop-ui/emulator/*.cpp, minus the GUI: each one
+//creates the game and system paks via mia, boots the ares system node, plugs in the
+//cartridge/disc and default controllers, and declares which nodes read which pak.
+
+#ifdef CORE_A26
+namespace ares::Atari2600 { auto load(Node::System& node, string name) -> bool; }
+#endif
+#ifdef CORE_A52
+namespace ares::Atari5200 { auto load(Node::System& node, string name) -> bool; }
+#endif
+#ifdef CORE_CV
+namespace ares::ColecoVision { auto load(Node::System& node, string name) -> bool; }
+#endif
+#ifdef CORE_MYVISION
+namespace ares::MyVision { auto load(Node::System& node, string name) -> bool; }
+#endif
+#ifdef CORE_FC
+namespace ares::Famicom { auto load(Node::System& node, string name) -> bool; }
+#endif
+#ifdef CORE_GB
+namespace ares::GameBoy { auto load(Node::System& node, string name) -> bool; }
+#endif
+#ifdef CORE_GBA
+namespace ares::GameBoyAdvance {
+  auto load(Node::System& node, string name) -> bool;
+  auto option(string name, string value) -> bool;
+}
+#endif
+#ifdef CORE_MD
+namespace ares::MegaDrive {
+  auto load(Node::System& node, string name) -> bool;
+  auto option(string name, string value) -> bool;
+}
+#endif
+#ifdef CORE_MS
+namespace ares::MasterSystem { auto load(Node::System& node, string name) -> bool; }
+#endif
+#ifdef CORE_MSX
+namespace ares::MSX { auto load(Node::System& node, string name) -> bool; }
+#endif
+#ifdef CORE_N64
+namespace ares::Nintendo64 {
+  auto load(Node::System& node, string name) -> bool;
+  auto option(string name, string value) -> bool;
+}
+#endif
+#ifdef CORE_NGP
+namespace ares::NeoGeoPocket { auto load(Node::System& node, string name) -> bool; }
+#endif
+#ifdef CORE_PCE
+namespace ares::PCEngine {
+  auto load(Node::System& node, string name) -> bool;
+  auto option(string name, string value) -> bool;
+}
+#endif
+#ifdef CORE_PS1
+namespace ares::PlayStation {
+  auto load(Node::System& node, string name) -> bool;
+  auto option(string name, string value) -> bool;
+}
+#endif
+#ifdef CORE_SFC
+namespace ares::SuperFamicom {
+  auto load(Node::System& node, string name) -> bool;
+  auto option(string name, string value) -> bool;
+}
+#endif
+#ifdef CORE_SG
+namespace ares::SG1000 { auto load(Node::System& node, string name) -> bool; }
+#endif
+#ifdef CORE_WS
+namespace ares::WonderSwan {
+  auto load(Node::System& node, string name) -> bool;
+  auto option(string name, string value) -> bool;
+}
+#endif
+
+namespace ares_libretro {
+
+namespace {
+
+using LoadFn = auto (*)(ares::Node::System&, string) -> bool;
+
+//------------------------------------------------------------------------------
+//helpers shared by the loaders
+
+auto describe(const LoadResult& result) -> string {
+  switch(result.result) {
+  case successful:            return "ok";
+  case noFileSelected:        return "no file selected";
+  case databaseNotFound:      return {"database file not found (", result.info, "); copy ares' Database folder to system/ares/Database"};
+  case romNotFoundInDatabase: return "game not found in the ares database";
+  case romNotFound:           return "file could not be opened";
+  case invalidROM:            return "the file is not a valid image (corrupt or bad dump?)";
+  case unsupportedMedia:      return "this hardware configuration is not supported by ares";
+  case wrongMediaType:        return {"wrong media type (", result.mediaType, ")"};
+  case couldNotParseManifest: return "could not parse the game manifest";
+  case noFirmware:            return "firmware missing or invalid";
+  case otherError:            return {"internal error ", result.info};
+  }
+  return "unknown error";
+}
+
+auto fail(const string& message) -> bool {
+  notify(message, 600, RETRO_LOG_ERROR);
+  return false;
+}
+
+//look for a firmware file in system/ares/ then system/
+auto findFirmware(std::initializer_list<const char*> names) -> string {
+  for(auto& name : names) {
+    for(auto& dir : {paths.system, paths.systemBase}) {
+      if(!dir) continue;
+      string location = {dir, name};
+      if(file::exists(location)) return location;
+    }
+  }
+  return {};
+}
+
+auto requireFirmware(const string& what, std::initializer_list<const char*> names) -> string {
+  auto location = findFirmware(names);
+  if(!location) {
+    string list;
+    for(auto& name : names) list.append(list ? ", " : "", name);
+    notify({"Missing ", what, ". Place one of [", list, "] in the frontend's system/ares/ folder."}, 900, RETRO_LOG_ERROR);
+  } else {
+    log(RETRO_LOG_INFO, {"firmware: ", what, " -> ", location});
+  }
+  return location;
+}
+
+//pick a region the way desktop-ui does: prefer the user's choice when the game supports it
+auto resolveRegion(Session& s) -> string {
+  string prefer = option::get("ares_region", "NTSC-U");
+  std::vector<string> preferred{prefer};
+  for(auto r : {"NTSC-U", "NTSC-J", "PAL"}) if(prefer != r) preferred.push_back(r);
+
+  if(s.game && s.game->pak) {
+    string regionList = s.game->pak->attribute("region");
+    auto regions = nall::split_and_strip(regionList, ",");
+    if(!regions.empty()) {
+      for(auto& p : preferred) {
+        if(std::ranges::find(regions, p) != regions.end()) return p;
+        if(p == "NTSC-U" || p == "NTSC-J") {
+          if(std::ranges::find(regions, string{"NTSC"}) != regions.end()) return "NTSC";
+        }
+      }
+      return regions.front();
+    }
+  }
+  return {};
+}
+
+//boot "<prefix> (<region>)", falling back through the region spellings ares cores use
+auto boot(Session& s, LoadFn load, const string& prefix, bool regional = true) -> bool {
+  if(!regional) {
+    if(load(s.root, prefix)) return true;
+    return fail({"ares could not create system \"", prefix, "\""});
+  }
+  std::vector<string> candidates;
+  auto add = [&](const string& r) {
+    if(r && std::ranges::find(candidates, r) == candidates.end()) candidates.push_back(r);
+  };
+  add(s.region);
+  if(s.region == "NTSC-U" || s.region == "NTSC-J") add("NTSC");
+  if(s.region == "NTSC") { add(option::get("ares_region") == "NTSC-J" ? "NTSC-J" : "NTSC-U"); }
+  add(option::get("ares_region"));
+  for(auto r : {"NTSC-U", "NTSC", "NTSC-J", "PAL"}) add(r);
+  for(auto& region : candidates) {
+    if(load(s.root, {prefix, " (", region, ")"})) {
+      s.region = region;
+      return true;
+    }
+  }
+  return fail({"ares could not create system \"", prefix, "\""});
+}
+
+auto loadGame(Session& s, const char* medium) -> bool {
+  s.game = mia::Medium::create(medium);
+  if(!s.game) return fail({"mia has no medium named ", medium});
+  auto result = s.game->load(s.location);
+  if(result != successful) return fail({"Could not load ", medium, " game: ", describe(result)});
+  s.region = resolveRegion(s);
+  return true;
+}
+
+auto loadSystem(Session& s, const char* name, const string& firmware = {}) -> bool {
+  s.system = mia::System::create(name);
+  if(!s.system) return fail({"mia has no system named ", name});
+  auto result = s.system->load(firmware);
+  if(result != successful) return fail({"Could not load ", name, " system: ", describe(result)});
+  return true;
+}
+
+auto connect(Session& s, const string& portName, const string& device = {}) -> ares::Node::Peripheral {
+  if(auto port = s.root->find<ares::Node::Port>(portName)) {
+    auto peripheral = port->allocate(device);
+    port->connect();
+    return peripheral;
+  }
+  return {};
+}
+
+//plug a default device into "Controller Port 1..count" and expose them as libretro ports
+auto controllers(Session& s, u32 count, const string& device, const string& prefix = "Controller Port ") -> void {
+  for(u32 n = 1; n <= count; n++) {
+    string name = count == 1 && prefix.endsWith("Port") ? prefix : string{prefix, n};
+    if(!s.root->find<ares::Node::Port>(name)) continue;
+    connect(s, name, device);
+    s.controllerPorts.push_back(name);
+    s.defaultDevices.push_back(device);
+  }
+}
+
+//desktop-ui's default save behavior
+auto standardSave(Session& s, bool systemNextToGame = false) -> void {
+  s.savers.push_back([&s, systemNextToGame] {
+    if(s.system) s.system->save(systemNextToGame ? s.game->location : s.system->location);
+    if(s.game) s.game->save(s.game->location);
+  });
+}
+
+auto pixelAccuracy() -> bool { return option::enabled("ares_pixel_accuracy"); }
+auto recompiler() -> bool { return option::enabled("ares_recompiler", true); }
+
+//------------------------------------------------------------------------------
+
+#ifdef CORE_FC
+auto loadFamicom(Session& s) -> bool {
+  if(!loadGame(s, "Famicom")) return false;
+  if(!loadSystem(s, "Famicom")) return false;
+  s.bind("Famicom", s.system);
+  s.bind("Famicom Cartridge", s.game);
+  if(!boot(s, ares::Famicom::load, "[Nintendo] Famicom")) return false;
+  connect(s, "Cartridge Slot");
+  controllers(s, 2, "Gamepad");
+  standardSave(s);
+  return true;
+}
+
+auto loadFamicomDiskSystem(Session& s) -> bool {
+  auto bios = requireFirmware("Famicom Disk System BIOS", {"disksys.rom", "fds_bios.bin"});
+  if(!bios) return false;
+  if(!loadGame(s, "Famicom Disk System")) return false;
+  auto biosPak = mia::Medium::create("Famicom");
+  if(auto result = biosPak->load(bios); result != successful) return fail({"Invalid Famicom Disk System BIOS: ", describe(result)});
+  if(!loadSystem(s, "Famicom")) return false;
+  s.bind("Famicom", s.system);
+  s.bind("Famicom Cartridge", biosPak);
+  s.bind("Famicom Disk System", s.game);
+  if(!ares::Famicom::load(s.root, "[Nintendo] Famicom (NTSC-J)")) return fail("ares could not create the Famicom");
+  connect(s, "Cartridge Slot");
+  if(auto port = s.root->scan<ares::Node::Port>("Disk Slot")) {
+    port->allocate();
+    port->connect();
+  }
+  if(auto state = s.root->scan<ares::Node::Setting::String>("State")) state->setValue("Disk 1: Side A");
+  controllers(s, 2, "Gamepad");
+  standardSave(s);
+  return true;
+}
+#endif
+
+#ifdef CORE_SFC
+auto loadSuperFamicom(Session& s) -> bool {
+  if(!loadGame(s, "Super Famicom")) return false;
+  if(!loadSystem(s, "Super Famicom")) return false;
+  ares::SuperFamicom::option("Pixel Accuracy", pixelAccuracy());
+  s.bind("Super Famicom", s.system);
+  s.bind("Super Famicom Cartridge", s.game);
+  if(!boot(s, ares::SuperFamicom::load, "[Nintendo] Super Famicom")) return false;
+  if(auto port = s.root->find<ares::Node::Port>("Cartridge Slot")) {
+    port->allocate();
+    port->connect();
+    //Super Game Boy / BS-X / Sufami Turbo slots stay empty: they need a second image
+  }
+  controllers(s, 2, "Gamepad");
+  standardSave(s);
+  return true;
+}
+#endif
+
+#ifdef CORE_GB
+auto loadGameBoyFamily(Session& s, const char* name) -> bool {
+  if(!loadGame(s, name)) return false;
+  if(!loadSystem(s, name)) return false;
+  s.bind(name, s.system);
+  s.bind({name, " Cartridge"}, s.game);
+  if(!boot(s, ares::GameBoy::load, {"[Nintendo] ", name}, false)) return false;
+  connect(s, "Cartridge Slot");
+  standardSave(s);
+  return true;
+}
+auto loadGameBoy(Session& s) -> bool { return loadGameBoyFamily(s, "Game Boy"); }
+auto loadGameBoyColor(Session& s) -> bool { return loadGameBoyFamily(s, "Game Boy Color"); }
+#endif
+
+#ifdef CORE_GBA
+auto loadGameBoyAdvance(Session& s) -> bool {
+  auto bios = requireFirmware("Game Boy Advance BIOS", {"gba_bios.bin", "gba.bin"});
+  if(!bios) return false;
+  if(!loadGame(s, "Game Boy Advance")) return false;
+  if(!loadSystem(s, "Game Boy Advance", bios)) return false;
+  ares::GameBoyAdvance::option("Pixel Accuracy", pixelAccuracy());
+  string model = option::enabled("ares_gba_player") ? "Game Boy Player" : "Game Boy Advance";
+  s.bind("Game Boy Advance", s.system);
+  s.bind("Game Boy Player", s.system);
+  s.bind("Game Boy Advance Cartridge", s.game);
+  if(!boot(s, ares::GameBoyAdvance::load, {"[Nintendo] ", model}, false)) return false;
+  connect(s, "Cartridge Slot");
+  standardSave(s);
+  return true;
+}
+#endif
+
+#ifdef CORE_MS
+auto loadMasterSystem(Session& s) -> bool {
+  if(!loadGame(s, "Master System")) return false;
+  //the BIOS is optional on the Master System
+  string bios;
+  if(s.region == "PAL")         bios = findFirmware({"bios_E.sms", "bios.sms"});
+  else if(s.region == "NTSC-J") bios = findFirmware({"bios_J.sms", "bios.sms"});
+  else                          bios = findFirmware({"bios_U.sms", "bios.sms"});
+  if(!loadSystem(s, "Master System", bios)) return false;
+  s.bind("Master System", s.system);
+  s.bind("Master System Cartridge", s.game);
+  if(!boot(s, ares::MasterSystem::load, "[Sega] Master System")) return false;
+  connect(s, "Cartridge Slot");
+  string device = "Gamepad";
+  if(s.game->pak->attribute("paddle").boolean()) device = "Paddle";
+  if(s.game->pak->attribute("sportspad").boolean()) device = "Sports Pad";
+  controllers(s, 2, device);
+  connect(s, "Expansion Port", "FM Sound Unit");
+  standardSave(s);
+  return true;
+}
+
+auto loadGameGear(Session& s) -> bool {
+  if(!loadGame(s, "Game Gear")) return false;
+  if(!loadSystem(s, "Game Gear", findFirmware({"bios.gg", "gg_bios.bin"}))) return false;
+  s.bind("Game Gear", s.system);
+  s.bind("Game Gear Cartridge", s.game);
+  if(!boot(s, ares::MasterSystem::load, "[Sega] Game Gear")) return false;
+  connect(s, "Cartridge Slot");
+  standardSave(s);
+  return true;
+}
+#endif
+
+#ifdef CORE_SG
+auto loadSG1000(Session& s) -> bool {
+  if(!loadGame(s, "SG-1000")) return false;
+  if(!loadSystem(s, "SG-1000")) return false;
+  s.bind("SG-1000", s.system);
+  s.bind("SG-1000 Cartridge", s.game);
+  if(!boot(s, ares::SG1000::load, "[Sega] SG-1000")) return false;
+  connect(s, "Cartridge Slot");
+  controllers(s, 2, "Gamepad");
+  standardSave(s);
+  return true;
+}
+#endif
+
