+auto findSystem(const string& name) -> const SystemDesc* {
+  for(auto& s : systems()) if(name == s.name) return &s;
+  return nullptr;
+}
+
+//choose a system for a file. Extensions are unambiguous for most systems; the rest
+//(.bin, .cue/.chd, .zip) go through mia::identify(), which test-loads the image.
+auto detectSystem(const string& location) -> const SystemDesc* {
+  auto extension = Location::suffix(location).trimLeft(".", 1L).downcase();
+
+  //Game Boy images with the CGB flag set run as Game Boy Color
+  if(extension == "gb") {
+    auto header = file::read(location);
+    if(header.size() > 0x143 && (header[0x143] & 0x80)) {
+      if(auto s = findSystem("Game Boy Color")) return s;
+    }
+  }
+
+  //.bin: Mega Drive images have "SEGA" at 0x100; small images are Atari 2600
+  if(extension == "bin") {
+    auto data = file::read(location);
+    if(data.size() >= 0x104 && (memory::compare(&data[0x100], "SEGA", 4) == 0 || memory::compare(&data[0x101], "SEGA", 4) == 0)) {
+      if(auto s = findSystem("Mega Drive")) return s;
+    }
+    if(data.size() <= 64_KiB) {
+      if(auto s = findSystem("Atari 2600")) return s;
+    }
+    if(auto s = findSystem("Mega Drive")) return s;
+  }
+
+  if(extension != "zip" && extension != "cue" && extension != "chd" && extension != "bin") {
+    for(auto& s : systems()) {
+      if(std::ranges::find(s.extensions, extension) != s.extensions.end()) return &s;
+    }
+  }
+
+  //CD images: check the unambiguous signatures first. mia's PC Engine CD analyzer treats any
+  //ISO 9660 disc as a possible Games Express title, which would also match PlayStation discs.
+  if(extension == "cue" || extension == "chd") {
+    if(auto disc = std::dynamic_pointer_cast<mia::CompactDisc>(mia::Medium::create("PlayStation"))) {
+      auto pvd = disc->readDataSector(location, 16);
+      if(pvd.size() >= 19 && memory::compare(pvd.data() + 8, "PLAYSTATION", 11) == 0) {
+        if(auto s = findSystem("PlayStation")) return s;
+      }
+      auto license = disc->readDataSector(location, 4);
+      string text;
+      text.resize(license.size());
+      if(license.size()) memory::copy(text.get(), license.data(), license.size());
+      if(text.find("Sony Computer Entertainment")) {
+        if(auto s = findSystem("PlayStation")) return s;
+      }
+      auto boot = disc->readDataSector(location, 0);
+      if(boot.size() >= 16 && (memory::compare(boot.data(), "SEGADISCSYSTEM", 14) == 0
+                            || memory::compare(boot.data(), "SEGABOOTDISC", 12) == 0)) {
+        if(auto s = findSystem("Mega CD")) return s;
+      }
+    }
+  }
+
+  //let mia test-load the image against every medium
+  auto matches = mia::identify(location);
+  //Mega CD and PC Engine CD verify disc signatures; mia's PlayStation medium accepts any
+  //data disc, so it must come after them
+  static const char* priority[] = {
+    "Mega CD", "PC Engine CD", "PlayStation",
+    "Super Famicom", "Famicom", "Mega Drive", "Game Boy Advance", "Game Boy Color", "Game Boy",
+    "Nintendo 64", "Master System", "Game Gear", "PC Engine", "SuperGrafx", "WonderSwan Color", "WonderSwan",
+    "Neo Geo Pocket Color", "Neo Geo Pocket", "Mega 32X", "SG-1000", "ColecoVision", "MSX2", "MSX",
+    "Atari 5200", "Atari 2600", "Famicom Disk System", "Pocket Challenge V2", "MyVision",
+  };
+  for(auto name : priority) {
+    if(std::ranges::find(matches, string{name}) == matches.end()) continue;
+    if(auto s = findSystem(name)) return s;
+  }
+  for(auto& match : matches) if(auto s = findSystem(match)) return s;
+  return nullptr;
+}
+
+}
diff --git a/libretro/tests/harness.cpp b/libretro/tests/harness.cpp
new file mode 100644
index 0000000..edccae0
--- /dev/null
+++ b/libretro/tests/harness.cpp
@@ -0,0 +1,195 @@
+// Minimal headless libretro frontend for testing ares_libretro.
+//   harness <core.so> <rom> <frames> [--press A@from-to] [--state-test] [--out frame.ppm] [--opt key=value]
+#include <dlfcn.h>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <cstdint>
+#include <cstdarg>
+#include <string>
+#include <vector>
+#include <map>
+#include <filesystem>
+#include "../libretro.h"
+
+static std::string systemDir, saveDir;
+static std::map<std::string, std::string> options;
+static std::vector<uint32_t> lastFrame;
+static unsigned lastW = 0, lastH = 0;
+static size_t audioFrames = 0;
+static unsigned frameNo = 0;
+static int pressId = -1, pressFrom = 0, pressTo = 0;
+static retro_system_av_info av{};
+static unsigned videoCalls = 0, dupes = 0, avChanges = 0;
+static std::vector<std::string> messages;
+
+static void logcb(enum retro_log_level level, const char* fmt, ...) {
+  if(level < RETRO_LOG_INFO && !getenv("VERBOSE")) return;
+  va_list ap; va_start(ap, fmt);
+  fprintf(stderr, "  core[%d]: ", (int)level); vfprintf(stderr, fmt, ap);
+  va_end(ap);
+}
+
+static bool env(unsigned cmd, void* data) {
+  switch(cmd) {
+  case RETRO_ENVIRONMENT_GET_LOG_INTERFACE: ((retro_log_callback*)data)->log = logcb; return true;
+  case RETRO_ENVIRONMENT_GET_SYSTEM_DIRECTORY: *(const char**)data = systemDir.c_str(); return true;
+  case RETRO_ENVIRONMENT_GET_SAVE_DIRECTORY: *(const char**)data = saveDir.c_str(); return true;
+  case RETRO_ENVIRONMENT_SET_PIXEL_FORMAT: return *(retro_pixel_format*)data == RETRO_PIXEL_FORMAT_XRGB8888;
+  case RETRO_ENVIRONMENT_GET_CAN_DUPE: *(bool*)data = true; return true;
+  case RETRO_ENVIRONMENT_GET_CORE_OPTIONS_VERSION: *(unsigned*)data = 2; return true;
+  case RETRO_ENVIRONMENT_SET_CORE_OPTIONS_V2: {
+    auto opts = (retro_core_options_v2*)data;
+    int n = 0; for(auto d = opts->definitions; d->key; d++) n++;
+    fprintf(stderr, "harness: %d core options registered\n", n);
+    return true;
+  }
+  case RETRO_ENVIRONMENT_GET_VARIABLE: {
+    auto var = (retro_variable*)data;
+    auto it = options.find(var->key);
+    if(it == options.end()) return false;
+    var->value = it->second.c_str();
+    return true;
+  }
+  case RETRO_ENVIRONMENT_GET_VARIABLE_UPDATE: *(bool*)data = false; return true;
+  case RETRO_ENVIRONMENT_SET_MESSAGE_EXT: messages.push_back(((retro_message_ext*)data)->msg); fprintf(stderr, "harness: OSD: %s\n", ((retro_message_ext*)data)->msg); return true;
+  case RETRO_ENVIRONMENT_SET_SYSTEM_AV_INFO: av = *(retro_system_av_info*)data; avChanges++;
+    fprintf(stderr, "harness: av_info -> %ux%u max %ux%u fps %.4f aspect %.3f\n", av.geometry.base_width, av.geometry.base_height, av.geometry.max_width, av.geometry.max_height, av.timing.fps, av.geometry.aspect_ratio);
+    return true;
+  case RETRO_ENVIRONMENT_SET_GEOMETRY: av.geometry = *(retro_game_geometry*)data; return true;
+  case RETRO_ENVIRONMENT_SET_CONTROLLER_INFO: {
+    auto info = (retro_controller_info*)data;
+    for(int p = 0; info[p].types; p++) {
+      fprintf(stderr, "harness: port %d devices:", p);
+      for(unsigned i = 0; i < info[p].num_types; i++) fprintf(stderr, " [%s]", info[p].types[i].desc);
+      fprintf(stderr, "\n");
+    }
+    return true;
+  }
+  case RETRO_ENVIRONMENT_SET_INPUT_DESCRIPTORS: {
+    int n = 0; for(auto d = (retro_input_descriptor*)data; d->description; d++) n++;
+    fprintf(stderr, "harness: %d input descriptors\n", n);
+    return true;
+  }
+  case RETRO_ENVIRONMENT_GET_INPUT_BITMASKS: return true;
+  case RETRO_ENVIRONMENT_SET_DISK_CONTROL_EXT_INTERFACE: fprintf(stderr, "harness: disk control interface set\n"); return true;
+  default: return false;
+  }
+}
+
+static void video(const void* data, unsigned w, unsigned h, size_t pitch) {
+  videoCalls++;
+  if(!data) { dupes++; return; }
+  lastW = w; lastH = h;
+  lastFrame.resize(w * h);
+  for(unsigned y = 0; y < h; y++) memcpy(&lastFrame[y * w], (const uint8_t*)data + y * pitch, w * 4);
+}
+static void audioSample(int16_t, int16_t) { audioFrames++; }
+static size_t audioBatch(const int16_t*, size_t frames) { audioFrames += frames; return frames; }
+static void inputPoll() {}
+static std::map<std::string, int> inputQueries;
+static int16_t inputState(unsigned port, unsigned device, unsigned index, unsigned id) {
+  if(getenv("INPUTLOG")) inputQueries[std::to_string(port) + ":" + std::to_string(device) + ":" + std::to_string(index) + ":" + std::to_string(id)]++;
+  bool held = port == 0 && (int)frameNo >= pressFrom && (int)frameNo <= pressTo;
+  if(device == RETRO_DEVICE_JOYPAD && id == RETRO_DEVICE_ID_JOYPAD_MASK) return held && pressId >= 0 ? (1 << pressId) : 0;
+  if(device == RETRO_DEVICE_JOYPAD) return held && (int)id == pressId;
+  return 0;
+}
+
+static uint64_t frameHash() {
+  uint64_t h = 1469598103934665603ull;
+  for(auto p : lastFrame) { h ^= p & 0xffffff; h *= 1099511628211ull; }
+  return h;
+}
+
+static void writePPM(const std::string& path) {
+  FILE* f = fopen(path.c_str(), "wb");
+  fprintf(f, "P6\n%u %u\n255\n", lastW, lastH);
+  for(auto p : lastFrame) { uint8_t rgb[3] = {uint8_t(p >> 16), uint8_t(p >> 8), uint8_t(p)}; fwrite(rgb, 1, 3, f); }
+  fclose(f);
+}
+
+#define SYM(name) auto name = (decltype(&::name))dlsym(core, #name); if(!name) { fprintf(stderr, "missing %s\n", #name); return 1; }
+
+int main(int argc, char** argv) {
+  if(argc < 4) { fprintf(stderr, "usage\n"); return 1; }
+  std::string out, second; bool stateTest = false; bool expectFail = false;
+  for(int i = 4; i < argc; i++) {
+    std::string a = argv[i];
+    if(a == "--out") out = argv[++i];
+    else if(a == "--state-test") stateTest = true;
+    else if(a == "--second") second = argv[++i];
+    else if(a == "--expect-fail") expectFail = true;
+    else if(a == "--opt") { std::string kv = argv[++i]; auto e = kv.find('='); options[kv.substr(0, e)] = kv.substr(e + 1); }
+    else if(a == "--press") { sscanf(argv[++i], "%d@%d-%d", &pressId, &pressFrom, &pressTo); }
+  }
+  systemDir = std::getenv("SYSDIR") ? std::getenv("SYSDIR") : "/tmp/rsys";
+  saveDir = std::getenv("SAVEDIR") ? std::getenv("SAVEDIR") : "/tmp/rsave";
+
+  void* core = dlopen(argv[1], RTLD_NOW | RTLD_LOCAL);
+  if(!core) { fprintf(stderr, "dlopen: %s\n", dlerror()); return 1; }
+  SYM(retro_set_environment) SYM(retro_set_video_refresh) SYM(retro_set_audio_sample) SYM(retro_set_audio_sample_batch)
+  SYM(retro_set_input_poll) SYM(retro_set_input_state) SYM(retro_init) SYM(retro_deinit) SYM(retro_get_system_info)
+  SYM(retro_get_system_av_info) SYM(retro_load_game) SYM(retro_unload_game) SYM(retro_run) SYM(retro_serialize_size)
+  SYM(retro_serialize) SYM(retro_unserialize) SYM(retro_api_version) SYM(retro_set_controller_port_device) SYM(retro_reset)
+
+  retro_system_info si{}; retro_get_system_info(&si);
+  fprintf(stderr, "harness: %s %s api=%u\n  extensions: %s\n", si.library_name, si.library_version, retro_api_version(), si.valid_extensions);
+  retro_set_environment(env);
+  retro_set_video_refresh(video); retro_set_audio_sample(audioSample); retro_set_audio_sample_batch(audioBatch);
+  retro_set_input_poll(inputPoll); retro_set_input_state(inputState);
+  retro_init();
+
+  retro_game_info game{argv[2], nullptr, 0, nullptr};
+  bool ok = retro_load_game(&game);
+  if(!ok) {
+    fprintf(stderr, "harness: retro_load_game failed\n");
+    retro_deinit();
+    return expectFail ? 0 : 2;
+  }
+  if(expectFail) { fprintf(stderr, "harness: expected failure but load succeeded\n"); return 3; }
+  retro_get_system_av_info(&av);
+  fprintf(stderr, "harness: av %ux%u max %ux%u fps %.4f rate %.0f aspect %.3f\n", av.geometry.base_width, av.geometry.base_height, av.geometry.max_width, av.geometry.max_height, av.timing.fps, av.timing.sample_rate, av.geometry.aspect_ratio);
+  for(unsigned p = 0; p < 2; p++) retro_set_controller_port_device(p, RETRO_DEVICE_JOYPAD);
+
+  int frames = atoi(argv[3]);
+  for(frameNo = 0; frameNo < (unsigned)frames; frameNo++) retro_run();
+  fprintf(stderr, "harness: ran %d frames: %u video calls (%u dupes), %zu audio frames (%.1f/frame), last %ux%u hash %016llx\n",
+    frames, videoCalls, dupes, audioFrames, (double)audioFrames / frames, lastW, lastH, (unsigned long long)frameHash());
+  if(!lastFrame.empty()) {
+    fprintf(stderr, "harness: center pixel %06x, corner pixel %06x\n", lastFrame[lastH / 2 * lastW + lastW / 2] & 0xffffff, lastFrame[8 * lastW + 8] & 0xffffff);
+  }
+
+  if(stateTest) {
+    size_t size = retro_serialize_size();
+    std::vector<uint8_t> state(size);
+    bool s1 = retro_serialize(state.data(), size);
+    for(int i = 0; i < 30; i++) { frameNo++; retro_run(); }
+    auto h1 = frameHash();
+    bool s2 = retro_unserialize(state.data(), size);
+    frameNo -= 30;
+    for(int i = 0; i < 30; i++) { frameNo++; retro_run(); }
+    auto h2 = frameHash();
+    fprintf(stderr, "harness: state size %zu serialize=%d unserialize=%d replay %s (%016llx vs %016llx)\n",
+      size, s1, s2, h1 == h2 ? "MATCHES" : "DIFFERS", (unsigned long long)h1, (unsigned long long)h2);
+    if(!s1 || !s2 || h1 != h2) return 4;
+  }
+
+  for(auto& [k, v] : inputQueries) fprintf(stderr, "harness: input query %s x%d\n", k.c_str(), v);
+  if(!out.empty()) writePPM(out);
+  retro_reset();
+  retro_run();
+  retro_unload_game();
+  if(!second.empty()) {
+    retro_game_info game2{second.c_str(), nullptr, 0, nullptr};
+    if(!retro_load_game(&game2)) { fprintf(stderr, "harness: second load failed\n"); return 5; }
+    lastFrame.clear();
+    for(int i = 0; i < 60; i++) retro_run();
+    fprintf(stderr, "harness: second game %s ran 60 frames, last %ux%u\n", second.c_str(), lastW, lastH);
+    retro_unload_game();
+  }
+  retro_deinit();
+  dlclose(core);
+  fprintf(stderr, "harness: clean shutdown\n");
+  return 0;
+}
diff --git a/libretro/tests/make_roms.py b/libretro/tests/make_roms.py
new file mode 100644
index 0000000..fee5c28
--- /dev/null
+++ b/libretro/tests/make_roms.py
@@ -0,0 +1,142 @@
+#!/usr/bin/env python3
+"""Build two tiny homebrew test ROMs (public-domain, written here) for the harness."""
+import sys, pathlib
+
+out = pathlib.Path(sys.argv[1] if len(sys.argv) > 1 else ".")
+
+class Asm:
+    def __init__(self, origin):
+        self.origin, self.code, self.labels, self.fix = origin, bytearray(), {}, []
+    def pc(self): return self.origin + len(self.code)
+    def label(self, n): self.labels[n] = self.pc()
+    def b(self, *bs): self.code += bytes(bs)
+    def abs16(self, op, addr): self.b(op, addr & 0xff, addr >> 8)
+    def rel(self, op, label): self.b(op, 0); self.fix.append((len(self.code) - 1, label, 'rel'))
+    def jmp(self, op, label): self.b(op, 0, 0); self.fix.append((len(self.code) - 2, label, 'abs'))
+    def resolve(self):
+        for pos, label, kind in self.fix:
+            target = self.labels[label]
+            if kind == 'rel':
+                off = target - (self.origin + pos + 1)
+                assert -128 <= off <= 127
+                self.code[pos] = off & 0xff
+            else:
+                self.code[pos] = target & 0xff; self.code[pos + 1] = target >> 8
+        return bytes(self.code)
+
+# ---------------------------------------------------------------- NES (NROM)
+a = Asm(0xC000)
+a.label('reset')
+a.b(0x78, 0xD8)                    # sei, cld
+a.b(0xA2, 0x40); a.abs16(0x8E, 0x4017)
+a.b(0xA2, 0xFF, 0x9A, 0xE8)        # ldx #$ff, txs, inx
+a.abs16(0x8E, 0x2000); a.abs16(0x8E, 0x2001); a.abs16(0x8E, 0x4010)
+for w in ('v1', 'v2'):
+    a.label(w); a.abs16(0x2C, 0x2002); a.rel(0x10, w)   # bit $2002 / bpl
+# square wave tone on pulse 1
+a.b(0xA9, 0x01); a.abs16(0x8D, 0x4015)
+a.b(0xA9, 0xBF); a.abs16(0x8D, 0x4000)
+a.b(0xA9, 0xFD); a.abs16(0x8D, 0x4002)
+a.b(0xA9, 0x00); a.abs16(0x8D, 0x4003)
+a.b(0xA9, 0x0A); a.abs16(0x8D, 0x2001)               # show background
+a.label('loop')
+a.b(0xA9, 0x01); a.abs16(0x8D, 0x4016); a.b(0xA9, 0x00); a.abs16(0x8D, 0x4016)
+a.abs16(0xAD, 0x4016); a.b(0x29, 0x01)               # lda $4016 (A button), and #1
+a.rel(0xF0, 'notA')
+a.b(0xA9, 0x16); a.jmp(0x4C, 'setc')                 # red
+a.label('notA'); a.b(0xA9, 0x21)                      # light blue
+a.label('setc'); a.b(0x85, 0x00)
+a.label('vw'); a.abs16(0x2C, 0x2002); a.rel(0x10, 'vw')
+a.b(0xA9, 0x3F); a.abs16(0x8D, 0x2006); a.b(0xA9, 0x00); a.abs16(0x8D, 0x2006)
+a.b(0xA5, 0x00); a.abs16(0x8D, 0x2007)
+a.b(0xA9, 0x00); a.abs16(0x8D, 0x2006); a.abs16(0x8D, 0x2006); a.abs16(0x8D, 0x2005); a.abs16(0x8D, 0x2005)
+a.jmp(0x4C, 'loop')
+a.label('nmi'); a.b(0x40)
+code = a.resolve()
+prg = bytearray(code + bytes(0x4000 - len(code)))
+prg[0x3FFA:0x4000] = bytes([a.labels['nmi'] & 0xff, a.labels['nmi'] >> 8,
+                            a.labels['reset'] & 0xff, a.labels['reset'] >> 8,
+                            a.labels['nmi'] & 0xff, a.labels['nmi'] >> 8])
+nes = b'NES\x1a' + bytes([1, 1, 0, 0]) + bytes(8) + prg + bytes(0x2000)
+(out / 'test.nes').write_bytes(nes)
+
+# ---------------------------------------------------------------- Game Boy
+rom = bytearray(0x8000)
+rom[0x100:0x104] = bytes([0x00, 0xC3, 0x50, 0x01])      # nop; jp $0150
+logo = bytes.fromhex('CEED6666CC0D000B03730083000C000D0008111F8889000EDCCC6EE6DDDDD999BBBB67636E0EECCCDDDC999FBBB9333E')
+rom[0x104:0x134] = logo
+rom[0x134:0x13F] = b'ARESTEST'.ljust(11, b'\0')
+rom[0x143] = 0x00; rom[0x147] = 0x00; rom[0x148] = 0x00; rom[0x149] = 0x00
+x = 0
+for i in range(0x134, 0x14D): x = (x - rom[i] - 1) & 0xff
+rom[0x14D] = x
+g = Asm(0x150)
+g.b(0xF3, 0x31, 0xFE, 0xFF)                    # di; ld sp,$fffe
+g.b(0x3E, 0x80, 0xE0, 0x26)                    # sound on (NR52)
+g.b(0x3E, 0x77, 0xE0, 0x24, 0x3E, 0xFF, 0xE0, 0x25)
+g.b(0x3E, 0x80, 0xE0, 0x11, 0x3E, 0xF0, 0xE0, 0x12, 0x3E, 0x00, 0xE0, 0x13, 0x3E, 0x87, 0xE0, 0x14)  # ch1 tone
+g.label('loop')
+g.b(0x3E, 0x10, 0xE0, 0x00, 0xF0, 0x00, 0xF0, 0x00, 0xE6, 0x01)   # read action buttons, and $01 (A)
+g.rel(0x20, 'up')                                                  # jr nz (not pressed)
+g.b(0x3E, 0x00, 0xE0, 0x47); g.rel(0x18, 'loop')                  # BGP=$00 (white)
+g.label('up'); g.b(0x3E, 0xFF, 0xE0, 0x47); g.rel(0x18, 'loop')   # BGP=$ff (black)
+code = g.resolve()
+rom[0x150:0x150 + len(code)] = code
+(out / 'test.gb').write_bytes(bytes(rom))
+print("wrote", out / 'test.nes', out / 'test.gb')
+
+# ---------------------------------------------------------------- smoke-test images (boot + idle loop)
+# SNES LoROM: force screen on, backdrop red, loop
+snes = bytearray(0x8000)
+code = bytes([0x78, 0x18, 0xFB,             # sei; clc; xce
+              0x9C, 0x21, 0x21,             # stz $2121
+              0xA9, 0x1F, 0x8D, 0x22, 0x21, # lda #$1f; sta $2122
+              0x9C, 0x22, 0x21,             # stz $2122
+              0xA9, 0x0F, 0x8D, 0x00, 0x21, # lda #$0f; sta $2100
+              0x80, 0xFE])                  # bra *
+snes[0:len(code)] = code
+snes[0x7FC0:0x7FD5] = b'ARES LIBRETRO TEST   '
+snes[0x7FD5] = 0x20; snes[0x7FD6] = 0x00; snes[0x7FD7] = 0x08; snes[0x7FD8] = 0; snes[0x7FD9] = 1; snes[0x7FDA] = 0x33
+ck = sum(snes) & 0xffff
+snes[0x7FDC:0x7FDE] = (ck ^ 0xffff).to_bytes(2, 'little'); snes[0x7FDE:0x7FE0] = ck.to_bytes(2, 'little')
+snes[0x7FFC:0x7FFE] = (0x8000).to_bytes(2, 'little'); snes[0x7FEA:0x7FEC] = (0x8000 + len(code) - 2).to_bytes(2, 'little')
+(out / 'test.sfc').write_bytes(bytes(snes))
+
+# Mega Drive: vectors, header, bra.s *
+md = bytearray(0x20000)
+md[0:4] = (0x00FFFE00).to_bytes(4, 'big'); md[4:8] = (0x200).to_bytes(4, 'big')
+md[0x100:0x110] = b'SEGA MEGA DRIVE '; md[0x120:0x130] = b'ARES TEST'.ljust(16)
+md[0x1A0:0x1A8] = bytes([0, 0, 0, 0, 0, 1, 0xFF, 0xFF]); md[0x1F0:0x1F3] = b'JUE'
+md[0x200:0x202] = bytes([0x60, 0xFE])
+(out / 'test.md').write_bytes(bytes(md))
+
+# Master System: di; im 1; jr $
+sms = bytearray(0x8000); sms[0:5] = bytes([0xF3, 0xED, 0x56, 0x18, 0xFE])
+sms[0x7FF0:0x7FF8] = b'TMR SEGA'; sms[0x7FFF] = 0x4C
+(out / 'test.sms').write_bytes(bytes(sms))
+
+# PC Engine: reset vector in the first 8KB bank (mapped at $E000)
+pce = bytearray(0x8000); pce[0:4] = bytes([0x78, 0xD4, 0x80, 0xFE])   # sei; csh; bra *
+pce[0x1FFE:0x2000] = (0xE000).to_bytes(2, 'little')
+(out / 'test.pce').write_bytes(bytes(pce))
+
+# Atari 2600 (4K)
+a26 = bytearray(0x1000); a26[0:5] = bytes([0x78, 0xD8, 0x4C, 0x02, 0xF0])   # sei; cld; jmp $f002
+a26[0xFFC:0xFFE] = (0xF000).to_bytes(2, 'little'); a26[0xFFE:0x1000] = (0xF000).to_bytes(2, 'little')
+(out / 'test.a26').write_bytes(bytes(a26))
+
+# WonderSwan (64KB, reset at FFFF:0000 jumps to F000:0000 = start of image)
+ws = bytearray(0x10000); ws[0:2] = bytes([0xEB, 0xFE])               # jmp $
+ws[-16:-11] = bytes([0xEA, 0x00, 0x00, 0x00, 0xF0])                  # jmp far F000:0000
+ws[-10] = 0x00; ws[-6] = 0x00; ws[-5] = 0x00; ws[-4] = 0x04
+(out / 'test.ws').write_bytes(bytes(ws))
+
+# N64: header only, no valid boot code (exercises the loader; the game will not run)
+n64 = bytearray(0x100000); n64[0:4] = bytes([0x80, 0x37, 0x12, 0x40]); n64[0x20:0x34] = b'ARES TEST'.ljust(20)
+n64[0x3B:0x3F] = b'NART'; n64[0x3E] = ord('E')
+(out / 'test.z64').write_bytes(bytes(n64))
+
+# GBA image with no BIOS available: must fail cleanly
+gba = bytearray(0x10000); gba[0:4] = bytes([0xFE, 0xFF, 0xFF, 0xEA])  # b .
+(out / 'test.gba').write_bytes(bytes(gba))
+print("wrote smoke-test images")
diff --git a/libretro/tools/gen-input-map.py b/libretro/tools/gen-input-map.py
new file mode 100644
index 0000000..6ba520e
--- /dev/null
+++ b/libretro/tools/gen-input-map.py
@@ -0,0 +1,165 @@
+#!/usr/bin/env python3
+"""
+Generate libretro/input-map.hpp from the controller definitions in desktop-ui/emulator/*.cpp.
+
+The desktop frontend describes every controller of every system as a list of
+  device.digital("Input Name", virtualPorts[id].pad.south);
+  device.analog ("X-Axis",     virtualPorts[id].pad.lstick_left, virtualPorts[id].pad.lstick_right);
+  ...
+where the virtual pad is an abstract Xbox/RetroPad-like controller. That is exactly the
+abstraction libretro uses, so we reuse upstream's layout verbatim instead of maintaining a
+second hand-written table. Re-run this script after pulling new upstream changes:
+
+  python3 libretro/tools/gen-input-map.py
+"""
+import pathlib
+import re
+import sys
+
+ROOT = pathlib.Path(__file__).resolve().parents[2]
+SRC = ROOT / "desktop-ui" / "emulator"
+OUT = ROOT / "libretro" / "input-map.hpp"
+
+SKIP = {"emulator.cpp", "emulators.cpp", "arcade.cpp"}
+
+FIELDS = [
+    # pad
+    "up", "down", "left", "right", "select", "start", "south", "east", "west", "north",
+    "l_bumper", "r_bumper", "l_trigger", "r_trigger", "lstick_click", "rstick_click",
+    "lstick_up", "lstick_down", "lstick_left", "lstick_right",
+    "rstick_up", "rstick_down", "rstick_left", "rstick_right", "rumble",
+    "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "zero",
+    "star", "clear", "pound", "point", "end",
+]
+MOUSE_FIELDS = ["x", "y", "left", "middle", "right", "extra"]
+
+# Places where libretro's established convention differs from desktop-ui's layout.
+# desktop-ui puts the NES "A" button on the bottom face button (Xbox A); every other libretro
+# NES core puts NES A on RetroPad A (east) and NES B on RetroPad B (south), so follow that.
+OVERRIDES = {
+    ("Famicom", "Gamepad", "A"): "Pad_east",
+    ("Famicom", "Gamepad", "B"): "Pad_south",
+    ("Famicom Disk System", "Gamepad", "A"): "Pad_east",
+    ("Famicom Disk System", "Gamepad", "B"): "Pad_south",
+}
+
+KINDS = {"digital": "Digital", "analog": "Analog", "relative": "Relative", "absolute": "Absolute", "rumble": "Rumble"}
+
+vp = r"virtualPorts\[[^\]]*\]\.(pad|mouse)\.(\w+)"
+re_name = re.compile(r'\bname\s*=\s*"([^"]+)"\s*;')
+re_device = re.compile(r'InputDevice\s+device\s*\{\s*"([^"]+)"\s*\}')
+re_device_loop = re.compile(r'for\s*\(\s*auto\s+name\s*:\s*\{([^}]*)\}\s*\)\s*\{\s*InputDevice\s+device\s*\{\s*name\s*\}')
+re_input = re.compile(r'device\.(digital|analog|relative|absolute|rumble)\s*\(\s*"([^"]+)"\s*,\s*' + vp + r'(?:\s*,\s*' + vp + r')?\s*\)')
+
+
+def field_id(group, field):
+    if group == "pad":
+        if field not in FIELDS:
+            return None
+        return "Pad_" + field
+    if field not in MOUSE_FIELDS:
+        return None
+    return "Mouse_" + field
+
+
+def parse(path):
+    text = path.read_text()
+    text = re.sub(r"//[^\n]*", "", text)          # strip line comments (commented-out inputs)
+    text = re.sub(r"/\*.*?\*/", "", text, flags=re.S)
+    text = re.sub(r"\s+", " ", text)
+    m = re_name.search(text)
+    if not m:
+        return None, {}
+    system = m.group(1)
+
+    devices = {}   # device name -> list of (input, kind, a, b), insertion ordered
+    current = []
+    events = []
+    for r in (re_device, re_device_loop, re_input):
+        for mm in r.finditer(text):
+            events.append((mm.start(), r, mm))
+    events.sort(key=lambda e: e[0])
+    for _, r, mm in events:
+        if r is re_device:
+            current = [mm.group(1)]
+            for d in current:
+                devices.setdefault(d, [])
+        elif r is re_device_loop:
+            current = re.findall(r'"([^"]+)"', mm.group(1))
+            for d in current:
+                devices.setdefault(d, [])
+        else:
+            kind, name, g1, f1, g2, f2 = mm.groups()
+            a = field_id(g1, f1)
+            b = field_id(g2, f2) if g2 else None
+            if a is None or (g2 and b is None):
+                print(f"warning: {path.name}: unknown field in {mm.group(0)}", file=sys.stderr)
+                continue
+            for d in current:
+                a2 = OVERRIDES.get((system, d, name), a)
+                entry = (name, KINDS[kind], a2, b or "None")
+                if entry not in devices[d]:
+                    devices[d].append(entry)
+    return system, {k: v for k, v in devices.items() if v}
+
+
+def cstr(s):
+    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'
+
+
+def main():
+    systems = {}
+    for path in sorted(SRC.glob("*.cpp")):
+        if path.name in SKIP:
+            continue
+        system, devices = parse(path)
+        if system and devices:
+            systems[system] = devices
+
+    out = []
+    out.append("// GENERATED by libretro/tools/gen-input-map.py from desktop-ui/emulator/*.cpp -- do not edit.")
+    out.append("#pragma once")
+    out.append("")
+    out.append("namespace ares_libretro::map {")
+    out.append("")
+    out.append("enum class Kind : u8 { Digital, Analog, Relative, Absolute, Rumble };")
+    out.append("enum class Field : u8 {")
+    out.append("  None,")
+    for f in FIELDS:
+        out.append(f"  Pad_{f},")
+    for f in MOUSE_FIELDS:
+        out.append(f"  Mouse_{f},")
+    out.append("};")
+    out.append("")
+    out.append("struct Input  { const char* name; Kind kind; Field a; Field b; };")
+    out.append("struct Device { const char* name; const Input* inputs; u32 count; };")
+    out.append("struct System { const char* name; const Device* devices; u32 count; };")
+    out.append("")
+    sys_entries = []
+    for si, (system, devices) in enumerate(systems.items()):
+        dev_entries = []
+        for di, (device, inputs) in enumerate(devices.items()):
+            ident = f"s{si}_d{di}"
+            out.append(f"// {system} / {device}")
+            out.append(f"inline constexpr Input {ident}[] = {{")
+            for name, kind, a, b in inputs:
+                out.append(f"  {{{cstr(name)}, Kind::{kind}, Field::{a}, Field::{b}}},")
+            out.append("};")
+            dev_entries.append(f"  {{{cstr(device)}, {ident}, {len(inputs)}}},")
+        out.append(f"inline constexpr Device s{si}[] = {{")
+        out.extend(dev_entries)
+        out.append("};")
+        out.append("")
+        sys_entries.append(f"  {{{cstr(system)}, s{si}, {len(devices)}}},")
+    out.append("inline constexpr System systemTables[] = {")
+    out.extend(sys_entries)
+    out.append("};")
+    out.append("")
+    out.append("}")
+    OUT.write_text("\n".join(out) + "\n")
+    print(f"wrote {OUT.relative_to(ROOT)}: {len(systems)} systems, "
+          f"{sum(len(d) for d in systems.values())} devices")
+
+
+if __name__ == "__main__":
+    main()
