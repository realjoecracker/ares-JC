@@ -0,0 +1,125 @@
+# SPDX-License-Identifier: ISC
+# Builds and smoke-tests the ares libretro core (libretro/) on Windows and Linux.
+# Each job uploads a ready-to-install package: cores/, info/, system/ares/Database/, licenses/.
+name: libretro
+
+on:
+  workflow_dispatch:
+  push:
+    paths:
+      - 'libretro/**'
+      - 'ares/**'
+      - 'mia/**'
+      - 'nall/**'
+      - 'libco/**'
+      - 'thirdparty/**'
+      - 'cmake/**'
+      - 'CMakeLists.txt'
+      - 'CMakePresets.json'
+      - '.github/workflows/libretro.yml'
+  pull_request:
+    paths:
+      - 'libretro/**'
+      - 'ares/**'
+      - 'mia/**'
+      - 'nall/**'
+      - 'libco/**'
+      - 'thirdparty/**'
+      - 'cmake/**'
+      - 'CMakeLists.txt'
+      - 'CMakePresets.json'
+      - '.github/workflows/libretro.yml'
+
+env:
+  LIBRETRO_FLAGS: >-
+    -DARES_BUILD_LIBRETRO=ON
+    -DARES_BUILD_DESKTOP=OFF
+    -DARES_BUILD_OPTIONAL_TARGETS=OFF
+    -DARES_LIBRETRO_TESTS=ON
+    -DENABLE_CCACHE=OFF
+
+jobs:
+  # Same toolchain as the official ares Windows release: Visual Studio + ClangCL,
+  # static CRT (no Visual C++ redistributable needed).
+  windows-x64:
+    runs-on: windows-latest
+    defaults:
+      run:
+        shell: bash
+    steps:
+      - uses: actions/checkout@v4
+      - name: Configure
+        run: cmake --preset windows-ci-cl-native $LIBRETRO_FLAGS
+      - name: Build
+        run: cmake --build build --config RelWithDebInfo --target ares_libretro ares_libretro_harness --parallel
+      - name: Test
+        run: >-
+          libretro/tests/run.sh
+          build/libretro/RelWithDebInfo/ares_libretro.dll
+          build/libretro/RelWithDebInfo/ares_libretro_harness.exe
+      - name: Package
+        run: |
+          cmake --install build --config RelWithDebInfo --prefix package
+          rm -rf package/bin
+          cp libretro/README.md package/
+      - uses: actions/upload-artifact@v4
+        with:
+          name: ares_libretro-windows-x64
+          path: package
+
+  # MSYS2 / MinGW clang build, as an alternative toolchain. Upstream ares does not build this
+  # configuration in CI, so a failure here does not fail the workflow.
+  windows-x64-mingw:
+    runs-on: windows-latest
+    continue-on-error: true
+    defaults:
+      run:
+        shell: msys2 {0}
+    steps:
+      - uses: msys2/setup-msys2@v2
+        with:
+          msystem: CLANG64
+          install: >-
+            git
+            mingw-w64-clang-x86_64-toolchain
+            mingw-w64-clang-x86_64-cmake
+            mingw-w64-clang-x86_64-ninja
+            mingw-w64-clang-x86_64-python
+      - uses: actions/checkout@v4
+      - name: Configure
+        run: cmake --preset windows-ci-mingw-native $LIBRETRO_FLAGS
+      - name: Build
+        run: cmake --build build --target ares_libretro ares_libretro_harness --parallel
+      - name: Test
+        run: libretro/tests/run.sh build/libretro/ares_libretro.dll build/libretro/ares_libretro_harness.exe
+      - name: Package
+        run: |
+          cmake --install build --prefix package
+          rm -rf package/bin
+          cp libretro/README.md package/
+      - uses: actions/upload-artifact@v4
+        with:
+          name: ares_libretro-windows-x64-mingw
+          path: package
+
+  linux-x64:
+    runs-on: ubuntu-24.04
+    steps:
+      - uses: actions/checkout@v4
+      - name: Install build tools
+        run: sudo apt-get update -qq && sudo apt-get install -y -qq ninja-build
+      - name: Configure
+        run: cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Release $LIBRETRO_FLAGS
+      - name: Build
+        run: cmake --build build --target ares_libretro ares_libretro_harness
+      - name: Test
+        run: libretro/tests/run.sh build/libretro/ares_libretro.so build/libretro/ares_libretro_harness
+      - name: Package
+        run: |
+          cmake --install build --prefix package --strip
+          rm -rf package/bin
+          cp libretro/README.md package/
+      - uses: actions/upload-artifact@v4
+        with:
+          name: ares_libretro-linux-x64
+          path: package
